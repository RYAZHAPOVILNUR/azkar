{"n":100,"na":"سُورَةُ العَادِيَاتِ","ne":"Al-Aadiyaat","nr":"Аль-Адият","nm":"Скачущие","t":"мекканская","c":11,"bism":true,"a":[{"n":1,"ar":"وَٱلْعَـٰدِيَـٰتِ ضَبْحًا","tj":"وَ[h:9999[ٱ]لْعَ[n[ـٰ]دِيَ[n[ـٰ]تِ ضَ[q:14611[بْ]حًا","ru":"Клянусь скачущими, запыхаясь!"},{"n":2,"ar":"فَٱلْمُورِيَـٰتِ قَدْحًا","tj":"فَ[h:9999[ٱ]لْمُورِيَ[n[ـٰ]تِ قَ[q:14612[دْ]حًا","ru":"Клянусь высекающими искры копытами!"},{"n":3,"ar":"فَٱلْمُغِيرَٲتِ صُبْحًا","tj":"فَ[h:9999[ٱ]لْمُغِير[n[َٲ]تِ صُ[q:14613[بْ]حًا","ru":"Клянусь нападающими на заре!"},{"n":4,"ar":"فَأَثَرْنَ بِهِۦ نَقْعًا","tj":"فَأَثَرْنَ بِه[n[ِۦ] نَ[q:14614[قْ]عًا","ru":"Тем самым они поднимают столб пыли"},{"n":5,"ar":"فَوَسَطْنَ بِهِۦ جَمْعًا","tj":"فَوَسَ[q:14615[طْ]نَ بِه[n[ِۦ] جَمْعًا","ru":"и врываются с ним (со столбом пыли или с всадником) в гущу."},{"n":6,"ar":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ","tj":"إِ[g[نّ]َ [h:7137[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ لِرَبِّه[n[ِۦ] لَكَن[p[ُو][q[د]ٌ","ru":"Воистину, человек неблагодарен своему Господу,"},{"n":7,"ar":"وَإِنَّهُۥ عَلَىٰ ذَٲلِكَ لَشَهِيدٌ","tj":"وَإِ[g[نّ]َهُ[n[ۥ] عَلَىٰ ذ[n[َٲ]لِكَ لَشَه[p[ِي][q[د]ٌ","ru":"и он сам является тому свидетелем."},{"n":8,"ar":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","tj":"وَإِ[g[نّ]َهُ[n[ۥ] لِحُبِّ [h:14616[ٱ]لْخَيْرِ لَشَد[p[ِي][q[د]ٌ","ru":"Воистину, он страстно любит блага."},{"n":9,"ar":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","tj":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى [h:8926[ٱ]لْقُب[p[ُو]رِ","ru":"Неужели он не знает, что, когда будет опрокинуто то, что в могилах,"},{"n":10,"ar":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","tj":"وَحُصِّلَ مَا فِى [h:6095[ٱ][l[ل]صُّد[p[ُو]رِ","ru":"и когда обнаружится то, что в груди,"},{"n":11,"ar":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرُۢ","tj":"إِ[g[نّ]َ رَبَّه[c:14617[ُم ب]ِهِمْ يَوْمَئِ[u:14618[ذٍ ل]َّخَب[p[ِي]رُۢ","ru":"в тот день Господь их будет осведомлен о них?"}]}