{"n":74,"na":"سُورَةُ المُدَّثِّرِ","ne":"Al-Muddaththir","nr":"Аль-Мудассир","nm":"Завернувшийся","t":"мекканская","c":56,"bism":true,"a":[{"n":1,"ar":"يَـٰٓأَيُّهَا ٱلْمُدَّثِّرُ","tj":"يَ[o[ـٰٓ]أَيُّهَا [h:14069[ٱ]لْمُدَّثِّرُ","ru":"О завернувшийся!"},{"n":2,"ar":"قُمْ فَأَنذِرْ","tj":"قُمْ فَأَ[f:14070[نذ]ِرْ","ru":"Встань и увещевай!"},{"n":3,"ar":"وَرَبَّكَ فَكَبِّرْ","tj":"وَرَبَّكَ فَكَبِّرْ","ru":"Господа своего величай!"},{"n":4,"ar":"وَثِيَابَكَ فَطَهِّرْ","tj":"وَثِيَابَكَ فَطَهِّرْ","ru":"Одежды свои очищай!"},{"n":5,"ar":"وَٱلرُّجْزَ فَٱهْجُرْ","tj":"وَ[h:9999[ٱ][l[ل]رُّ[q:14071[جْ]زَ فَ[h:14072[ٱ]هْجُرْ","ru":"Скверны (идолов) сторонись!"},{"n":6,"ar":"وَلَا تَمْنُن تَسْتَكْثِرُ","tj":"وَلَا تَمْنُ[f:14073[ن ت]َسْتَكْثِرُ","ru":"Не оказывай милости, чтобы получить большее!"},{"n":7,"ar":"وَلِرَبِّكَ فَٱصْبِرْ","tj":"وَلِرَبِّكَ فَ[h:6374[ٱ]صْبِرْ","ru":"Ради Господа твоего будь терпелив!"},{"n":8,"ar":"فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ","tj":"فَإِذَا نُقِرَ فِى [h:14074[ٱ][l[ل][g[نّ]َاق[p[ُو]رِ","ru":"Когда же протрубят в рог,"},{"n":9,"ar":"فَذَٲلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ","tj":"فَذ[n[َٲ]لِكَ يَوْمَئِ[a:14075[ذٍ ي]َوْمٌ عَس[p[ِي]رٌ","ru":"то день тот будет Днем тяжким,"},{"n":10,"ar":"عَلَى ٱلْكَـٰفِرِينَ غَيْرُ يَسِيرٍ","tj":"عَلَى [h:468[ٱ]لْكَ[n[ـٰ]فِرِينَ غَيْرُ يَس[p[ِي]رٍ","ru":"нелегким для неверующих."},{"n":11,"ar":"ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًا","tj":"ذَرْنِى وَمَنْ خَلَ[q:11606[قْ]تُ وَحِيدًا","ru":"Оставь Меня с тем, кого Я сотворил одиноким,"},{"n":12,"ar":"وَجَعَلْتُ لَهُۥ مَالاً مَّمْدُودًا","tj":"وَجَعَلْتُ لَهُ[n[ۥ] مَال[a:14076[اً م]َّمْدُودًا","ru":"даровал ему большое богатство"},{"n":13,"ar":"وَبَنِينَ شُهُودًا","tj":"وَبَنِينَ شُهُودًا","ru":"и сыновей, которые находились рядом с ним,"},{"n":14,"ar":"وَمَهَّدتُّ لَهُۥ تَمْهِيدًا","tj":"وَمَهَّ[d:14077[د]تُّ لَهُ[n[ۥ] تَمْهِيدًا","ru":"и распростер перед ним этот мир полностью."},{"n":15,"ar":"ثُمَّ يَطْمَعُ أَنْ أَزِيدَ","tj":"ثُ[g[مّ]َ يَ[q:14078[طْ]مَعُ أَنْ أَز[p[ِي][q[د]َ","ru":"После всего этого он желает, чтобы Я добавил ему."},{"n":16,"ar":"كَلَّآ‌ۖ إِنَّهُۥ كَانَ لِأَيَـٰتِنَا عَنِيدًا","tj":"كَلّ[o[َآ‌ۖ] إِ[g[نّ]َهُ[n[ۥ] كَانَ لِأَيَ[n[ـٰ]تِنَا عَنِيدًا","ru":"Но нет! Он упрямо отрицает Наши знамения."},{"n":17,"ar":"سَأُرْهِقُهُۥ صَعُودًا","tj":"سَأُرْهِقُهُ[n[ۥ] صَعُودًا","ru":"Я возложу на него подъем (восхождение на гору в Аду)."},{"n":18,"ar":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ","tj":"إِ[g[نّ]َهُ[n[ۥ] فَكَّرَ وَقَدَّرَ","ru":"Он подумал и рассчитал."},{"n":19,"ar":"فَقُتِلَ كَيْفَ قَدَّرَ","tj":"فَقُتِلَ كَيْفَ قَدَّرَ","ru":"Да сгинет он! Как он рассчитал?!"},{"n":20,"ar":"ثُمَّ قُتِلَ كَيْفَ قَدَّرَ","tj":"ثُ[g[مّ]َ قُتِلَ كَيْفَ قَدَّرَ","ru":"Да сгинет он еще раз! Как он рассчитал?!"},{"n":21,"ar":"ثُمَّ نَظَرَ","tj":"ثُ[g[مّ]َ نَظَرَ","ru":"Затем он задумался."},{"n":22,"ar":"ثُمَّ عَبَسَ وَبَسَرَ","tj":"ثُ[g[مّ]َ عَبَسَ وَبَسَرَ","ru":"Затем он нахмурился и насупился."},{"n":23,"ar":"ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ","tj":"ثُ[g[مّ]َ أَ[q:13927[دْ]بَرَ وَ[h:181[ٱ]سْتَكْبَرَ","ru":"Затем он повернулся спиной и возгордился"},{"n":24,"ar":"فَقَالَ إِنْ هَـٰذَآ إِلَّا سِحْرٌ يُؤْثَرُ","tj":"فَقَالَ إِنْ هَ[n[ـٰ]ذ[o[َآ] إِلَّا سِحْ[a:14079[رٌ ي]ُؤْثَرُ","ru":"и сказал: «Это - не что иное, как пересказанное колдовство."},{"n":25,"ar":"إِنْ هَـٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ","tj":"إِنْ هَ[n[ـٰ]ذ[o[َآ] إِلَّا قَوْلُ [h:14080[ٱ]لْبَشَرِ","ru":"Это - не что иное, как слова человека»."},{"n":26,"ar":"سَأُصْلِيهِ سَقَرَ","tj":"سَأُصْلِيهِ سَقَرَ","ru":"Я брошу его в Преисподнюю."},{"n":27,"ar":"وَمَآ أَدْرَٮٰكَ مَا سَقَرُ","tj":"وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا سَقَرُ","ru":"Откуда ты мог знать, что такое Преисподняя?"},{"n":28,"ar":"لَا تُبْقِى وَلَا تَذَرُ","tj":"لَا تُ[q:14081[بْ]قِى وَلَا تَذَرُ","ru":"Она не щадит и не оставляет."},{"n":29,"ar":"لَوَّاحَةٌ لِّلْبَشَرِ","tj":"لَوَّاحَ[u:14082[ةٌ ل]ِّلْبَشَرِ","ru":"Она сжигает кожу."},{"n":30,"ar":"عَلَيْهَا تِسْعَةَ عَشَرَ","tj":"عَلَيْهَا تِسْعَةَ عَشَرَ","ru":"Их (ангелов) над ней - девятнадцать."},{"n":31,"ar":"وَمَا جَعَلْنَآ أَصْحَـٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةً‌ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِّلَّذِينَ كَفَرُواْ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُواْ ٱلْكِتَـٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓاْ إِيمَـٰنًا‌ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُواْ ٱلْكِتَـٰبَ وَٱلْمُؤْمِنُونَ‌ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَٱلْكَـٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلاً‌ۚ كَذَٲلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ‌ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ‌ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ","tj":"وَمَا جَعَلْن[o[َآ] أَصْحَ[n[ـٰ]بَ [h:4701[ٱ][l[ل][g[نّ]َارِ إِلَّا مَلَ[o[ـٰٓ]ئِكَ[a:14083[ةً‌ۙ و]َمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَ[u:9071[ةً ل]ِّلَّذِينَ كَفَرُو[s[اْ] لِيَسْتَيْقِنَ [h:14084[ٱ]لَّذِينَ أُوتُو[s[اْ] [h:524[ٱ]لْكِتَ[n[ـٰ]بَ وَيَزْدَادَ [h:14085[ٱ]لَّذِينَ ءَامَن[o[ُوٓ][s[اْ] إِيمَ[n[ـٰ][a:14086[نًا‌ۙ و]َلَا يَرْتَابَ [h:14087[ٱ]لَّذِينَ أُوتُو[s[اْ] [h:524[ٱ]لْكِتَ[n[ـٰ]بَ وَ[h:1709[ٱ]لْمُؤْمِنُونَ‌ۙ وَلِيَقُولَ [h:14088[ٱ]لَّذِينَ فِى قُلُوبِه[w:39[ِم م]َّرَ[a:14089[ضٌ و]َ[h:1467[ٱ]لْكَ[n[ـٰ]فِرُونَ مَاذ[o[َآ] أَرَادَ [h:139[ٱ]للَّهُ بِهَ[n[ـٰ]ذَا مَثَل[f:14090[اً‌ۚ ك]َذ[n[َٲ]لِكَ يُضِلُّ [h:11866[ٱ]للَّهُ م[a:476[َن ي]َش[o[َا]ٓءُ وَيَهْدِى م[a:476[َن ي]َش[o[َا]ٓءُ‌ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ‌ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ","ru":"Стражами Огня мы сделали только ангелов, а количество их сделали искушением для неверующих, чтобы удостоверились те, кому было даровано Писание, чтобы усилилась вера у верующих, чтобы не сомневались те, кому было даровано Писание, и верующие, и чтобы спросили те, чьи сердца поражены недугом, и неверующие: «Что хотел Аллах этой притчей?». Так Аллах вводит в заблуждение, кого пожелает, и ведет прямым путем, кого пожелает. Воинство твоего Господа не знает никто, кроме Него. Это же - не что иное, как Напоминание для человечества."},{"n":32,"ar":"كَلَّا وَٱلْقَمَرِ","tj":"كَلَّا وَ[h:14091[ٱ]لْقَمَرِ","ru":"О да! Клянусь луной!"},{"n":33,"ar":"وَٱلَّيْلِ إِذْ أَدْبَرَ","tj":"وَ[h:9999[ٱ]لَّيْلِ إِذْ أَ[q:13927[دْ]بَرَ","ru":"Клянусь ночью, когда она отступает!"},{"n":34,"ar":"وَٱلصُّبْحِ إِذَآ أَسْفَرَ","tj":"وَ[h:9999[ٱ][l[ل]صُّ[q:14092[بْ]حِ إِذ[o[َآ] أَسْفَرَ","ru":"Клянусь зарей, когда она занимается!"},{"n":35,"ar":"إِنَّهَا لَإِحْدَى ٱلْكُبَرِ","tj":"إِ[g[نّ]َهَا لَإِحْدَى [h:14093[ٱ]لْكُبَرِ","ru":"Это есть одно из величайших явлений,"},{"n":36,"ar":"نَذِيرًا لِّلْبَشَرِ","tj":"نَذِي[u:14094[رًا ل]ِّلْبَشَرِ","ru":"предостерегающее человечество -"},{"n":37,"ar":"لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ","tj":"لِمَ[f:14095[ن ش][o[َا]ٓءَ مِ[f:344[نك]ُمْ أ[a:14096[َن ي]َتَقَدَّمَ أَوْ يَتَأَخَّرَ","ru":"тех из вас, кто желает продвигаться вперед благодаря праведным деяниям или отступать назад, совершая грехи."},{"n":38,"ar":"كُلُّ نَفْسِۭ بِمَا كَسَبَتْ رَهِينَةٌ","tj":"كُلُّ نَفْ[i:6995[سِۭ ب]ِمَا كَسَبَتْ رَهِينَةٌ","ru":"Каждый человек является заложником того, что он приобрел,"},{"n":39,"ar":"إِلَّآ أَصْحَـٰبَ ٱلْيَمِينِ","tj":"إِلّ[o[َآ] أَصْحَ[n[ـٰ]بَ [h:14097[ٱ]لْيَم[p[ِي]نِ","ru":"кроме людей правой стороны."},{"n":40,"ar":"فِى جَنَّـٰتٍ يَتَسَآءَلُونَ","tj":"فِى جَ[g[نّ]َ[n[ـٰ][a:14098[تٍ ي]َتَس[o[َا]ٓءَل[p[ُو]نَ","ru":"В Райских садах они будут расспрашивать друг друга"},{"n":41,"ar":"عَنِ ٱلْمُجْرِمِينَ","tj":"عَنِ [h:14099[ٱ]لْمُ[q:4093[جْ]رِم[p[ِي]نَ","ru":"о грешниках."},{"n":42,"ar":"مَا سَلَكَكُمْ فِى سَقَرَ","tj":"مَا سَلَكَكُمْ فِى سَقَرَ","ru":"Что привело вас в Преисподнюю?"},{"n":43,"ar":"قَالُواْ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ","tj":"قَالُو[s[اْ] لَمْ نَكُ مِنَ [h:14100[ٱ]لْمُصَلّ[p[ِي]نَ","ru":"Они скажут: «Мы не были в числе тех, которые совершали намаз."},{"n":44,"ar":"وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ","tj":"وَلَمْ نَكُ نُ[q:14101[طْ]عِمُ [h:14102[ٱ]لْمِسْك[p[ِي]نَ","ru":"Мы не кормили бедняков."},{"n":45,"ar":"وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ","tj":"وَكُ[g[نّ]َا نَخُوضُ مَعَ [h:14103[ٱ]لْخ[o[َا]ٓئِض[p[ِي]نَ","ru":"Мы погружались в словоблудие вместе с погружавшимися."},{"n":46,"ar":"وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ","tj":"وَكُ[g[نّ]َا نُكَذِّبُ بِيَوْمِ [h:13931[ٱ][l[ل]دّ[p[ِي]نِ","ru":"Мы считали ложью Последний день,"},{"n":47,"ar":"حَتَّىٰٓ أَتَـٰنَا ٱلْيَقِينُ","tj":"حَتَّ[o[ىٰٓ] أَتَ[n[ـٰ]نَا [h:14104[ٱ]لْيَق[p[ِي]نُ","ru":"пока к нам не явилась убежденность (смерть)»."},{"n":48,"ar":"فَمَا تَنفَعُهُمْ شَفَـٰعَةُ ٱلشَّـٰفِعِينَ","tj":"فَمَا تَ[f:14105[نف]َعُهُمْ شَفَ[n[ـٰ]عَةُ [h:14106[ٱ][l[ل]شَّ[n[ـٰ]فِع[p[ِي]نَ","ru":"Заступничество заступников не поможет им."},{"n":49,"ar":"فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ","tj":"فَمَا لَهُمْ عَنِ [h:14107[ٱ][l[ل]تَّذْكِرَةِ مُعْرِض[p[ِي]نَ","ru":"Что же с ними? Почему они отворачиваются от Напоминания,"},{"n":50,"ar":"كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ","tj":"كَأَ[g[نّ]َهُمْ حُمُ[a:14108[رٌ م]ُّسْتَ[f:14109[نف]ِرَةٌ","ru":"словно напуганные ослы,"},{"n":51,"ar":"فَرَّتْ مِن قَسْوَرَةِۭ","tj":"فَرَّتْ مِ[f:14110[ن ق]َسْوَرَةِۭ","ru":"бегущие от стрелка (или льва)?"},{"n":52,"ar":"بَلْ يُرِيدُ كُلُّ ٱمْرِىٍٕ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًا مُّنَشَّرَةً","tj":"بَلْ يُرِيدُ كُلُّ [h:12916[ٱ]مْرِى[a:9346[ٍٕ م]ِّنْهُمْ أ[a:2024[َن ي]ُؤْتَىٰ صُحُ[a:14111[فًا م]ُّنَشَّرَةً","ru":"Но ведь каждый из них желает получить развернутые свитки."},{"n":53,"ar":"كَلَّا‌ۖ بَل لَّا يَخَافُونَ ٱلْأَخِرَةَ","tj":"كَلَّا‌ۖ بَل لَّا يَخَافُونَ [h:14112[ٱ]لْأَخِرَةَ","ru":"Но нет! Они не боятся Последней жизни."},{"n":54,"ar":"كَلَّآ إِنَّهُۥ تَذْكِرَةٌ","tj":"كَلّ[o[َآ] إِ[g[نّ]َهُ[n[ۥ] تَذْكِرَةٌ","ru":"Но нет! Это есть Назидание."},{"n":55,"ar":"فَمَن شَآءَ ذَكَرَهُۥ","tj":"فَمَ[f:8041[ن ش][o[َا]ٓءَ ذَكَرَهُۥ","ru":"Помянет его тот, кто захочет."},{"n":56,"ar":"وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ‌ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ","tj":"وَمَا يَذْكُرُونَ إِلّ[o[َآ] أ[a:4201[َن ي]َش[o[َا]ٓءَ [h:4334[ٱ]للَّهُ‌ۚ هُوَ أَهْلُ [h:14113[ٱ][l[ل]تَّ[q:1084[قْ]وَىٰ وَأَهْلُ [h:14114[ٱ]لْمَغْفِرَةِ","ru":"Но они не помянут его, если этого не пожелает Аллах. Он - Тот, Кто достоин страха и способен на прощение."}]}