{"n":1,"na":"سُورَةُ ٱلْفَاتِحَةِ","ne":"Al-Faatiha","nr":"Аль-Фатиха","nm":"Открывающая","t":"мекканская","c":7,"bism":false,"a":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","tj":"بِسْمِ [h:1[ٱ]للَّهِ [h:2[ٱ][l[ل]رَّحْمَ[n[ـٰ]نِ [h:3[ٱ][l[ل]رَّح[p[ِي]مِ","ru":"Во имя Аллаха, Милостивого, Милосердного!"},{"n":2,"ar":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ","tj":"ٱلْحَمْدُ لِلَّهِ رَبِّ [h:4[ٱ]لْعَ[n[ـٰ]لَم[p[ِي]نَ","ru":"Хвала Аллаху, Господу миров,"},{"n":3,"ar":"ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","tj":"ٱ[l[ل]رَّحْمَ[n[ـٰ]نِ [h:3[ٱ][l[ل]رَّح[p[ِي]مِ","ru":"Милостивому, Милосердному,"},{"n":4,"ar":"مَـٰلِكِ يَوْمِ ٱلدِّينِ","tj":"مَ[n[ـٰ]لِكِ يَوْمِ [h:5[ٱ][l[ل]دّ[p[ِي]نِ","ru":"Властелину Дня воздаяния!"},{"n":5,"ar":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","tj":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَع[p[ِي]نُ","ru":"Тебе одному мы поклоняемся и Тебя одного молим о помощи."},{"n":6,"ar":"ٱهْدِنَا ٱلصِّرَٲطَ ٱلْمُسْتَقِيمَ","tj":"ٱهْدِنَا [h:6[ٱ][l[ل]صِّر[n[َٲ]طَ [h:7[ٱ]لْمُسْتَق[p[ِي]مَ","ru":"Веди нас прямым путем,"},{"n":7,"ar":"صِرَٲطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","tj":"صِر[n[َٲ]طَ [h:8[ٱ]لَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ [h:9[ٱ]لْمَغْضُوبِ عَلَيْهِمْ وَلَا [h:10[ٱ][l[ل]ضّ[m[َا]ٓلّ[p[ِي]نَ","ru":"путем тех, кого Ты облагодетельствовал, не тех, на кого пал гнев, и не заблудших."}]}