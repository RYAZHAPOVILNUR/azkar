[{"n": 1, "t": "عَبَسَ وَتَوَلَّىٰٓ ١", "p": 585}, {"n": 2, "t": "أَن جَآءَهُ ٱلۡأَعۡمَىٰ ٢", "p": 585}, {"n": 3, "t": "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ ٣", "p": 585}, {"n": 4, "t": "أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ ٤", "p": 585}, {"n": 5, "t": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ ٥", "p": 585}, {"n": 6, "t": "فَأَنتَ لَهُۥ تَصَدَّىٰ ٦", "p": 585}, {"n": 7, "t": "وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ ٧", "p": 585}, {"n": 8, "t": "وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ ٨", "p": 585}, {"n": 9, "t": "وَهُوَ يَخۡشَىٰ ٩", "p": 585}, {"n": 10, "t": "فَأَنتَ عَنۡهُ تَلَهَّىٰ ١٠", "p": 585}, {"n": 11, "t": "كـَلَّآ إِنَّهَا تَذۡكِرَةٞ ١١", "p": 585}, {"n": 12, "t": "فَمَن شَآءَ ذَكَرَهُۥ ١٢", "p": 585}, {"n": 13, "t": "فِي صُحُفٖ مُّكَرَّمَةٖ ١٣", "p": 585}, {"n": 14, "t": "مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ ١٤", "p": 585}, {"n": 15, "t": "بِأَيۡدِي سَفَرَةٖ ١٥", "p": 585}, {"n": 16, "t": "كِرَامِۭ بَرَرَةٖ ١٦", "p": 585}, {"n": 17, "t": "قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ ١٧", "p": 585}, {"n": 18, "t": "مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ ١٨", "p": 585}, {"n": 19, "t": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ١٩", "p": 585}, {"n": 20, "t": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ ٢٠", "p": 585}, {"n": 21, "t": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ ٢١", "p": 585}, {"n": 22, "t": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ ٢٢", "p": 585}, {"n": 23, "t": "كـَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ ٢٣", "p": 585}, {"n": 24, "t": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ ٢٤", "p": 585}, {"n": 25, "t": "أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا ٢٥", "p": 585}, {"n": 26, "t": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا ٢٦", "p": 585}, {"n": 27, "t": "فَأَنۢبَتۡنَا فِيهَا حَبّٗا ٢٧", "p": 585}, {"n": 28, "t": "وَعِنَبٗا وَقَضۡبٗا ٢٨", "p": 585}, {"n": 29, "t": "وَزَيۡتُونٗا وَنَخۡلٗا ٢٩", "p": 585}, {"n": 30, "t": "وَحَدَآئِقَ غُلۡبٗا ٣٠", "p": 585}, {"n": 31, "t": "وَفَٰكِهَةٗ وَأَبّٗا ٣١", "p": 585}, {"n": 32, "t": "مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ٣٢", "p": 585}, {"n": 33, "t": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ ٣٣", "p": 585}, {"n": 34, "t": "يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ ٣٤", "p": 585}, {"n": 35, "t": "وَأُمِّهِۦ وَأَبِيهِ ٣٥", "p": 585}, {"n": 36, "t": "وَصَٰحِبَتِهِۦ وَبَنِيهِ ٣٦", "p": 585}, {"n": 37, "t": "لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ ٣٧", "p": 585}, {"n": 38, "t": "وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ ٣٨", "p": 585}, {"n": 39, "t": "ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ ٣٩", "p": 585}, {"n": 40, "t": "وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ ٤٠", "p": 585}, {"n": 41, "t": "تَرۡهَقُهَا قَتَرَةٌ ٤١", "p": 586}, {"n": 42, "t": "أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ ٤٢", "p": 586}]