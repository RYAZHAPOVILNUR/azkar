[{"n": 1, "t": "قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ ١", "p": 603}, {"n": 2, "t": "لَآ أَعۡبُدُ مَا تَعۡبُدُونَ ٢", "p": 603}, {"n": 3, "t": "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ ٣", "p": 603}, {"n": 4, "t": "وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ ٤", "p": 603}, {"n": 5, "t": "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ ٥", "p": 603}, {"n": 6, "t": "لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ ٦", "p": 603}]