[{"n": 1, "t": "إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ ١", "p": 534}, {"n": 2, "t": "لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ ٢", "p": 534}, {"n": 3, "t": "خَافِضَةٞ رَّافِعَةٌ ٣", "p": 534}, {"n": 4, "t": "إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجّٗا ٤", "p": 534}, {"n": 5, "t": "وَبُسَّتِ ٱلۡجِبَالُ بَسّٗا ٥", "p": 534}, {"n": 6, "t": "فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا ٦", "p": 534}, {"n": 7, "t": "وَكُنتُمۡ أَزۡوَٰجٗا ثَلَٰثَةٗ ٧", "p": 534}, {"n": 8, "t": "فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ مَآ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ ٨", "p": 534}, {"n": 9, "t": "وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ ٩", "p": 534}, {"n": 10, "t": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ ١٠", "p": 534}, {"n": 11, "t": "أُوْلَٰٓئِكَ ٱلۡمُقَرَّبُونَ ١١", "p": 534}, {"n": 12, "t": "فِي جَنَّٰتِ ٱلنَّعِيمِ ١٢", "p": 534}, {"n": 13, "t": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ ١٣", "p": 534}, {"n": 14, "t": "وَقَلِيلٞ مِّنَ ٱلۡأٓخِرِينَ ١٤", "p": 534}, {"n": 15, "t": "عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ ١٥", "p": 534}, {"n": 16, "t": "مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ ١٦", "p": 534}, {"n": 17, "t": "يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ ١٧", "p": 535}, {"n": 18, "t": "بِأَكۡوَابٖ وَأَبَارِيقَ وَكَأۡسٖ مِّن مَّعِينٖ ١٨", "p": 535}, {"n": 19, "t": "لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزِفُونَ ١٩", "p": 535}, {"n": 20, "t": "وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ ٢٠", "p": 535}, {"n": 21, "t": "وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ ٢١", "p": 535}, {"n": 22, "t": "وَحُورٌ عِينٞ ٢٢", "p": 535}, {"n": 23, "t": "كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ ٢٣", "p": 535}, {"n": 24, "t": "جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ ٢٤", "p": 535}, {"n": 25, "t": "لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا ٢٥", "p": 535}, {"n": 26, "t": "إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا ٢٦", "p": 535}, {"n": 27, "t": "وَأَصۡحَٰبُ ٱلۡيَمِينِ مَآ أَصۡحَٰبُ ٱلۡيَمِينِ ٢٧", "p": 535}, {"n": 28, "t": "فِي سِدۡرٖ مَّخۡضُودٖ ٢٨", "p": 535}, {"n": 29, "t": "وَطَلۡحٖ مَّنضُودٖ ٢٩", "p": 535}, {"n": 30, "t": "وَظِلّٖ مَّمۡدُودٖ ٣٠", "p": 535}, {"n": 31, "t": "وَمَآءٖ مَّسۡكُوبٖ ٣١", "p": 535}, {"n": 32, "t": "وَفَٰكِهَةٖ كَثِيرَةٖ ٣٢", "p": 535}, {"n": 33, "t": "لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ ٣٣", "p": 535}, {"n": 34, "t": "وَفُرُشٖ مَّرۡفُوعَةٍ ٣٤", "p": 535}, {"n": 35, "t": "إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءٗ ٣٥", "p": 535}, {"n": 36, "t": "فَجَعَلۡنَٰهُنَّ أَبۡكَارًا ٣٦", "p": 535}, {"n": 37, "t": "عُرُبًا أَتۡرَابٗا ٣٧", "p": 535}, {"n": 38, "t": "لِّأَصۡحَٰبِ ٱلۡيَمِينِ ٣٨", "p": 535}, {"n": 39, "t": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ ٣٩", "p": 535}, {"n": 40, "t": "وَثُلَّةٞ مِّنَ ٱلۡأٓخِرِينَ ٤٠", "p": 535}, {"n": 41, "t": "وَأَصۡحَٰبُ ٱلشِّمَالِ مَآ أَصۡحَٰبُ ٱلشِّمَالِ ٤١", "p": 535}, {"n": 42, "t": "فِي سَمُومٖ وَحَمِيمٖ ٤٢", "p": 535}, {"n": 43, "t": "وَظِلّٖ مِّن يَحۡمُومٖ ٤٣", "p": 535}, {"n": 44, "t": "لَّا بَارِدٖ وَلَا كَرِيمٍ ٤٤", "p": 535}, {"n": 45, "t": "إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ ٤٥", "p": 535}, {"n": 46, "t": "وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ ٤٦", "p": 535}, {"n": 47, "t": "وَكَانُواْ يَقُولُونَ أَئِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ ٤٧", "p": 535}, {"n": 48, "t": "أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ ٤٨", "p": 535}, {"n": 49, "t": "قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ ٤٩", "p": 535}, {"n": 50, "t": "لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ ٥٠", "p": 535}, {"n": 51, "t": "ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ ٥١", "p": 536}, {"n": 52, "t": "لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ ٥٢", "p": 536}, {"n": 53, "t": "فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ ٥٣", "p": 536}, {"n": 54, "t": "فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ ٥٤", "p": 536}, {"n": 55, "t": "فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ ٥٥", "p": 536}, {"n": 56, "t": "هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ ٥٦", "p": 536}, {"n": 57, "t": "نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ ٥٧", "p": 536}, {"n": 58, "t": "أَفَرَءَيۡتُم مَّا تُمۡنُونَ ٥٨", "p": 536}, {"n": 59, "t": "ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ ٥٩", "p": 536}, {"n": 60, "t": "نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ ٦٠", "p": 536}, {"n": 61, "t": "عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ ٦١", "p": 536}, {"n": 62, "t": "وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ ٦٢", "p": 536}, {"n": 63, "t": "أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ ٦٣", "p": 536}, {"n": 64, "t": "ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ ٦٤", "p": 536}, {"n": 65, "t": "لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ ٦٥", "p": 536}, {"n": 66, "t": "إِنَّا لَمُغۡرَمُونَ ٦٦", "p": 536}, {"n": 67, "t": "بَلۡ نَحۡنُ مَحۡرُومُونَ ٦٧", "p": 536}, {"n": 68, "t": "أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ ٦٨", "p": 536}, {"n": 69, "t": "ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ ٦٩", "p": 536}, {"n": 70, "t": "لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ ٧٠", "p": 536}, {"n": 71, "t": "أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ ٧١", "p": 536}, {"n": 72, "t": "ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ ٧٢", "p": 536}, {"n": 73, "t": "نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ ٧٣", "p": 536}, {"n": 74, "t": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٧٤", "p": 536}, {"n": 75, "t": "۞ فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ ٧٥", "p": 536}, {"n": 76, "t": "وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ ٧٦", "p": 536}, {"n": 77, "t": "إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ ٧٧", "p": 537}, {"n": 78, "t": "فِي كِتَٰبٖ مَّكۡنُونٖ ٧٨", "p": 537}, {"n": 79, "t": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلۡمُطَهَّرُونَ ٧٩", "p": 537}, {"n": 80, "t": "تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ ٨٠", "p": 537}, {"n": 81, "t": "أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُم مُّدۡهِنُونَ ٨١", "p": 537}, {"n": 82, "t": "وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ ٨٢", "p": 537}, {"n": 83, "t": "فَلَوۡلَآ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ ٨٣", "p": 537}, {"n": 84, "t": "وَأَنتُمۡ حِينَئِذٖ تَنظُرُونَ ٨٤", "p": 537}, {"n": 85, "t": "وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ ٨٥", "p": 537}, {"n": 86, "t": "فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ ٨٦", "p": 537}, {"n": 87, "t": "تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ ٨٧", "p": 537}, {"n": 88, "t": "فَأَمَّآ إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ ٨٨", "p": 537}, {"n": 89, "t": "فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ ٨٩", "p": 537}, {"n": 90, "t": "وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ٩٠", "p": 537}, {"n": 91, "t": "فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ٩١", "p": 537}, {"n": 92, "t": "وَأَمَّآ إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ ٩٢", "p": 537}, {"n": 93, "t": "فَنُزُلٞ مِّنۡ حَمِيمٖ ٩٣", "p": 537}, {"n": 94, "t": "وَتَصۡلِيَةُ جَحِيمٍ ٩٤", "p": 537}, {"n": 95, "t": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ ٩٥", "p": 537}, {"n": 96, "t": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٩٦", "p": 537}]