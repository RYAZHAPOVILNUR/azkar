[{"n": 1, "t": "ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ ١", "p": 597}, {"n": 2, "t": "خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ ٢", "p": 597}, {"n": 3, "t": "ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ ٣", "p": 597}, {"n": 4, "t": "ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ ٤", "p": 597}, {"n": 5, "t": "عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ ٥", "p": 597}, {"n": 6, "t": "كـَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ ٦", "p": 597}, {"n": 7, "t": "أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ ٧", "p": 597}, {"n": 8, "t": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ ٨", "p": 597}, {"n": 9, "t": "أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ ٩", "p": 597}, {"n": 10, "t": "عَبۡدًا إِذَا صَلَّىٰٓ ١٠", "p": 597}, {"n": 11, "t": "أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ ١١", "p": 597}, {"n": 12, "t": "أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ ١٢", "p": 597}, {"n": 13, "t": "أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ ١٣", "p": 598}, {"n": 14, "t": "أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ ١٤", "p": 598}, {"n": 15, "t": "كـَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ ١٥", "p": 598}, {"n": 16, "t": "نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ ١٦", "p": 598}, {"n": 17, "t": "فَلۡيَدۡعُ نَادِيَهُۥ ١٧", "p": 598}, {"n": 18, "t": "سَنَدۡعُ ٱلزَّبَانِيَةَ ١٨", "p": 598}, {"n": 19, "t": "كـَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩ ١٩", "p": 598}]