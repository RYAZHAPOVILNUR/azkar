[{"n": 1, "t": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى ١", "p": 591}, {"n": 2, "t": "ٱلَّذِي خَلَقَ فَسَوَّىٰ ٢", "p": 591}, {"n": 3, "t": "وَٱلَّذِي قَدَّرَ فَهَدَىٰ ٣", "p": 591}, {"n": 4, "t": "وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ ٤", "p": 591}, {"n": 5, "t": "فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ ٥", "p": 591}, {"n": 6, "t": "سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ ٦", "p": 591}, {"n": 7, "t": "إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ ٧", "p": 591}, {"n": 8, "t": "وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ ٨", "p": 591}, {"n": 9, "t": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ ٩", "p": 591}, {"n": 10, "t": "سَيَذَّكَّرُ مَن يَخۡشَىٰ ١٠", "p": 591}, {"n": 11, "t": "وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى ١١", "p": 592}, {"n": 12, "t": "ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ ١٢", "p": 592}, {"n": 13, "t": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ ١٣", "p": 592}, {"n": 14, "t": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ ١٤", "p": 592}, {"n": 15, "t": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ ١٥", "p": 592}, {"n": 16, "t": "بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا ١٦", "p": 592}, {"n": 17, "t": "وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ ١٧", "p": 592}, {"n": 18, "t": "إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ ١٨", "p": 592}, {"n": 19, "t": "صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ ١٩", "p": 592}]