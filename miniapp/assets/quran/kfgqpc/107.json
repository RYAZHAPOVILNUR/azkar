[{"n": 1, "t": "أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ ١", "p": 602}, {"n": 2, "t": "فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ ٢", "p": 602}, {"n": 3, "t": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ٣", "p": 602}, {"n": 4, "t": "فَوَيۡلٞ لِّلۡمُصَلِّينَ ٤", "p": 602}, {"n": 5, "t": "ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ ٥", "p": 602}, {"n": 6, "t": "ٱلَّذِينَ هُمۡ يُرَآءُونَ ٦", "p": 602}, {"n": 7, "t": "وَيَمۡنَعُونَ ٱلۡمَاعُونَ ٧", "p": 602}]