[{"n": 1, "t": "عَمَّ يَتَسَآءَلُونَ ١", "p": 582}, {"n": 2, "t": "عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ ٢", "p": 582}, {"n": 3, "t": "ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ ٣", "p": 582}, {"n": 4, "t": "كـَلَّا سَيَعۡلَمُونَ ٤", "p": 582}, {"n": 5, "t": "ثُمَّ كـَلَّا سَيَعۡلَمُونَ ٥", "p": 582}, {"n": 6, "t": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا ٦", "p": 582}, {"n": 7, "t": "وَٱلۡجِبَالَ أَوۡتَادٗا ٧", "p": 582}, {"n": 8, "t": "وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا ٨", "p": 582}, {"n": 9, "t": "وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا ٩", "p": 582}, {"n": 10, "t": "وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا ١٠", "p": 582}, {"n": 11, "t": "وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا ١١", "p": 582}, {"n": 12, "t": "وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا ١٢", "p": 582}, {"n": 13, "t": "وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا ١٣", "p": 582}, {"n": 14, "t": "وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا ١٤", "p": 582}, {"n": 15, "t": "لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا ١٥", "p": 582}, {"n": 16, "t": "وَجَنَّٰتٍ أَلۡفَافًا ١٦", "p": 582}, {"n": 17, "t": "إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا ١٧", "p": 582}, {"n": 18, "t": "يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا ١٨", "p": 582}, {"n": 19, "t": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا ١٩", "p": 582}, {"n": 20, "t": "وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا ٢٠", "p": 582}, {"n": 21, "t": "إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا ٢١", "p": 582}, {"n": 22, "t": "لِّلطَّٰغِينَ مَـَٔابٗا ٢٢", "p": 582}, {"n": 23, "t": "لَّٰبِثِينَ فِيهَآ أَحۡقَابٗا ٢٣", "p": 582}, {"n": 24, "t": "لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا ٢٤", "p": 582}, {"n": 25, "t": "إِلَّا حَمِيمٗا وَغَسَّاقٗا ٢٥", "p": 582}, {"n": 26, "t": "جَزَآءٗ وِفَاقًا ٢٦", "p": 582}, {"n": 27, "t": "إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا ٢٧", "p": 582}, {"n": 28, "t": "وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا ٢٨", "p": 582}, {"n": 29, "t": "وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا ٢٩", "p": 582}, {"n": 30, "t": "فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا ٣٠", "p": 582}, {"n": 31, "t": "إِنَّ لِلۡمُتَّقِينَ مَفَازًا ٣١", "p": 583}, {"n": 32, "t": "حَدَآئِقَ وَأَعۡنَٰبٗا ٣٢", "p": 583}, {"n": 33, "t": "وَكَوَاعِبَ أَتۡرَابٗا ٣٣", "p": 583}, {"n": 34, "t": "وَكَأۡسٗا دِهَاقٗا ٣٤", "p": 583}, {"n": 35, "t": "لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّٰبٗا ٣٥", "p": 583}, {"n": 36, "t": "جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا ٣٦", "p": 583}, {"n": 37, "t": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا ٣٧", "p": 583}, {"n": 38, "t": "يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا ٣٨", "p": 583}, {"n": 39, "t": "ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا ٣٩", "p": 583}, {"n": 40, "t": "إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا ٤٠", "p": 583}]