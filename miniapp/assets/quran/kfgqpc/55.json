[{"n": 1, "t": "ٱلرَّحۡمَٰنُ ١", "p": 531}, {"n": 2, "t": "عَلَّمَ ٱلۡقُرۡءَانَ ٢", "p": 531}, {"n": 3, "t": "خَلَقَ ٱلۡإِنسَٰنَ ٣", "p": 531}, {"n": 4, "t": "عَلَّمَهُ ٱلۡبَيَانَ ٤", "p": 531}, {"n": 5, "t": "ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ ٥", "p": 531}, {"n": 6, "t": "وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ ٦", "p": 531}, {"n": 7, "t": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ ٧", "p": 531}, {"n": 8, "t": "أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ ٨", "p": 531}, {"n": 9, "t": "وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ ٩", "p": 531}, {"n": 10, "t": "وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ ١٠", "p": 531}, {"n": 11, "t": "فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ ١١", "p": 531}, {"n": 12, "t": "وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ ١٢", "p": 531}, {"n": 13, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٣", "p": 531}, {"n": 14, "t": "خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ ١٤", "p": 531}, {"n": 15, "t": "وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ ١٥", "p": 531}, {"n": 16, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٦", "p": 531}, {"n": 17, "t": "رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ ١٧", "p": 531}, {"n": 18, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٨", "p": 531}, {"n": 19, "t": "مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ ١٩", "p": 532}, {"n": 20, "t": "بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ ٢٠", "p": 532}, {"n": 21, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢١", "p": 532}, {"n": 22, "t": "يَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ ٢٢", "p": 532}, {"n": 23, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢٣", "p": 532}, {"n": 24, "t": "وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ ٢٤", "p": 532}, {"n": 25, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢٥", "p": 532}, {"n": 26, "t": "كُلُّ مَنۡ عَلَيۡهَا فَانٖ ٢٦", "p": 532}, {"n": 27, "t": "وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ ٢٧", "p": 532}, {"n": 28, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢٨", "p": 532}, {"n": 29, "t": "يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنٖ ٢٩", "p": 532}, {"n": 30, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٠", "p": 532}, {"n": 31, "t": "سَنَفۡرُغُ لَكُمۡ أَيُّهَ ٱلثَّقَلَانِ ٣١", "p": 532}, {"n": 32, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٢", "p": 532}, {"n": 33, "t": "يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ ٣٣", "p": 532}, {"n": 34, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٤", "p": 532}, {"n": 35, "t": "يُرۡسَلُ عَلَيۡكُمَا شُوَاظٞ مِّن نَّارٖ وَنُحَاسٞ فَلَا تَنتَصِرَانِ ٣٥", "p": 532}, {"n": 36, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٦", "p": 532}, {"n": 37, "t": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةٗ كَٱلدِّهَانِ ٣٧", "p": 532}, {"n": 38, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٨", "p": 532}, {"n": 39, "t": "فَيَوۡمَئِذٖ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞ ٣٩", "p": 532}, {"n": 40, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٤٠", "p": 532}, {"n": 41, "t": "يُعۡرَفُ ٱلۡمُجۡرِمُونَ بِسِيمَٰهُمۡ فَيُؤۡخَذُ بِٱلنَّوَٰصِي وَٱلۡأَقۡدَامِ ٤١", "p": 532}, {"n": 42, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٤٢", "p": 533}, {"n": 43, "t": "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي يُكَذِّبُ بِهَا ٱلۡمُجۡرِمُونَ ٤٣", "p": 533}, {"n": 44, "t": "يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانٖ ٤٤", "p": 533}, {"n": 45, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٤٥", "p": 533}, {"n": 46, "t": "وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ ٤٦", "p": 533}, {"n": 47, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٤٧", "p": 533}, {"n": 48, "t": "ذَوَاتَآ أَفۡنَانٖ ٤٨", "p": 533}, {"n": 49, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٤٩", "p": 533}, {"n": 50, "t": "فِيهِمَا عَيۡنَانِ تَجۡرِيَانِ ٥٠", "p": 533}, {"n": 51, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٥١", "p": 533}, {"n": 52, "t": "فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوۡجَانِ ٥٢", "p": 533}, {"n": 53, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٥٣", "p": 533}, {"n": 54, "t": "مُتَّكِـِٔينَ عَلَىٰ فُرُشِۭ بَطَآئِنُهَا مِنۡ إِسۡتَبۡرَقٖۚ وَجَنَى ٱلۡجَنَّتَيۡنِ دَانٖ ٥٤", "p": 533}, {"n": 55, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٥٥", "p": 533}, {"n": 56, "t": "فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرۡفِ لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ ٥٦", "p": 533}, {"n": 57, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٥٧", "p": 533}, {"n": 58, "t": "كَأَنَّهُنَّ ٱلۡيَاقُوتُ وَٱلۡمَرۡجَانُ ٥٨", "p": 533}, {"n": 59, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٥٩", "p": 533}, {"n": 60, "t": "هَلۡ جَزَآءُ ٱلۡإِحۡسَٰنِ إِلَّا ٱلۡإِحۡسَٰنُ ٦٠", "p": 533}, {"n": 61, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٦١", "p": 533}, {"n": 62, "t": "وَمِن دُونِهِمَا جَنَّتَانِ ٦٢", "p": 533}, {"n": 63, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٦٣", "p": 533}, {"n": 64, "t": "مُدۡهَآمَّتَانِ ٦٤", "p": 533}, {"n": 65, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٦٥", "p": 533}, {"n": 66, "t": "فِيهِمَا عَيۡنَانِ نَضَّاخَتَانِ ٦٦", "p": 533}, {"n": 67, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٦٧", "p": 533}, {"n": 68, "t": "فِيهِمَا فَٰكِهَةٞ وَنَخۡلٞ وَرُمَّانٞ ٦٨", "p": 533}, {"n": 69, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٦٩", "p": 533}, {"n": 70, "t": "فِيهِنَّ خَيۡرَٰتٌ حِسَانٞ ٧٠", "p": 534}, {"n": 71, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٧١", "p": 534}, {"n": 72, "t": "حُورٞ مَّقۡصُورَٰتٞ فِي ٱلۡخِيَامِ ٧٢", "p": 534}, {"n": 73, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٧٣", "p": 534}, {"n": 74, "t": "لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ ٧٤", "p": 534}, {"n": 75, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٧٥", "p": 534}, {"n": 76, "t": "مُتَّكِـِٔينَ عَلَىٰ رَفۡرَفٍ خُضۡرٖ وَعَبۡقَرِيٍّ حِسَانٖ ٧٦", "p": 534}, {"n": 77, "t": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٧٧", "p": 534}, {"n": 78, "t": "تَبَٰرَكَ ٱسۡمُ رَبِّكَ ذِي ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ ٧٨", "p": 534}]