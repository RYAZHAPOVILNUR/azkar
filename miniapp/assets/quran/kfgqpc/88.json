[{"n": 1, "t": "هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ ١", "p": 592}, {"n": 2, "t": "وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ ٢", "p": 592}, {"n": 3, "t": "عَامِلَةٞ نَّاصِبَةٞ ٣", "p": 592}, {"n": 4, "t": "تَصۡلَىٰ نَارًا حَامِيَةٗ ٤", "p": 592}, {"n": 5, "t": "تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ ٥", "p": 592}, {"n": 6, "t": "لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ ٦", "p": 592}, {"n": 7, "t": "لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ ٧", "p": 592}, {"n": 8, "t": "وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ ٨", "p": 592}, {"n": 9, "t": "لِّسَعۡيِهَا رَاضِيَةٞ ٩", "p": 592}, {"n": 10, "t": "فِي جَنَّةٍ عَالِيَةٖ ١٠", "p": 592}, {"n": 11, "t": "لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ ١١", "p": 592}, {"n": 12, "t": "فِيهَا عَيۡنٞ جَارِيَةٞ ١٢", "p": 592}, {"n": 13, "t": "فِيهَا سُرُرٞ مَّرۡفُوعَةٞ ١٣", "p": 592}, {"n": 14, "t": "وَأَكۡوَابٞ مَّوۡضُوعَةٞ ١٤", "p": 592}, {"n": 15, "t": "وَنَمَارِقُ مَصۡفُوفَةٞ ١٥", "p": 592}, {"n": 16, "t": "وَزَرَابِيُّ مَبۡثُوثَةٌ ١٦", "p": 592}, {"n": 17, "t": "أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ ١٧", "p": 592}, {"n": 18, "t": "وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ ١٨", "p": 592}, {"n": 19, "t": "وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ ١٩", "p": 592}, {"n": 20, "t": "وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ ٢٠", "p": 592}, {"n": 21, "t": "فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ ٢١", "p": 592}, {"n": 22, "t": "لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ ٢٢", "p": 592}, {"n": 23, "t": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ ٢٣", "p": 593}, {"n": 24, "t": "فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ ٢٤", "p": 593}, {"n": 25, "t": "إِنَّ إِلَيۡنَآ إِيَابَهُمۡ ٢٥", "p": 593}, {"n": 26, "t": "ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم ٢٦", "p": 593}]