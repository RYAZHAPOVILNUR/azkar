[{"n": 1, "t": "وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا ١", "p": 580}, {"n": 2, "t": "فَٱلۡعَٰصِفَٰتِ عَصۡفٗا ٢", "p": 580}, {"n": 3, "t": "وَٱلنَّٰشِرَٰتِ نَشۡرٗا ٣", "p": 580}, {"n": 4, "t": "فَٱلۡفَٰرِقَٰتِ فَرۡقٗا ٤", "p": 580}, {"n": 5, "t": "فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا ٥", "p": 580}, {"n": 6, "t": "عُذۡرًا أَوۡ نُذۡرًا ٦", "p": 580}, {"n": 7, "t": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ ٧", "p": 580}, {"n": 8, "t": "فَإِذَا ٱلنُّجُومُ طُمِسَتۡ ٨", "p": 580}, {"n": 9, "t": "وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ ٩", "p": 580}, {"n": 10, "t": "وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ ١٠", "p": 580}, {"n": 11, "t": "وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ ١١", "p": 580}, {"n": 12, "t": "لِأَيِّ يَوۡمٍ أُجِّلَتۡ ١٢", "p": 580}, {"n": 13, "t": "لِيَوۡمِ ٱلۡفَصۡلِ ١٣", "p": 580}, {"n": 14, "t": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ ١٤", "p": 580}, {"n": 15, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ١٥", "p": 580}, {"n": 16, "t": "أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ ١٦", "p": 580}, {"n": 17, "t": "ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ ١٧", "p": 580}, {"n": 18, "t": "كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ ١٨", "p": 580}, {"n": 19, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ١٩", "p": 580}, {"n": 20, "t": "أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ ٢٠", "p": 581}, {"n": 21, "t": "فَجَعَلۡنَٰهُ فِي قَرَارٖ مَّكِينٍ ٢١", "p": 581}, {"n": 22, "t": "إِلَىٰ قَدَرٖ مَّعۡلُومٖ ٢٢", "p": 581}, {"n": 23, "t": "فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ ٢٣", "p": 581}, {"n": 24, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٢٤", "p": 581}, {"n": 25, "t": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا ٢٥", "p": 581}, {"n": 26, "t": "أَحۡيَآءٗ وَأَمۡوَٰتٗا ٢٦", "p": 581}, {"n": 27, "t": "وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا ٢٧", "p": 581}, {"n": 28, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٢٨", "p": 581}, {"n": 29, "t": "ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ ٢٩", "p": 581}, {"n": 30, "t": "ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ ٣٠", "p": 581}, {"n": 31, "t": "لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ ٣١", "p": 581}, {"n": 32, "t": "إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ ٣٢", "p": 581}, {"n": 33, "t": "كَأَنَّهُۥ جِمَٰلَتٞ صُفۡرٞ ٣٣", "p": 581}, {"n": 34, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٣٤", "p": 581}, {"n": 35, "t": "هَٰذَا يَوۡمُ لَا يَنطِقُونَ ٣٥", "p": 581}, {"n": 36, "t": "وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ ٣٦", "p": 581}, {"n": 37, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٣٧", "p": 581}, {"n": 38, "t": "هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ ٣٨", "p": 581}, {"n": 39, "t": "فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ ٣٩", "p": 581}, {"n": 40, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٤٠", "p": 581}, {"n": 41, "t": "إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ ٤١", "p": 581}, {"n": 42, "t": "وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ ٤٢", "p": 581}, {"n": 43, "t": "كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ ٤٣", "p": 581}, {"n": 44, "t": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ٤٤", "p": 581}, {"n": 45, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٤٥", "p": 581}, {"n": 46, "t": "كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ ٤٦", "p": 581}, {"n": 47, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٤٧", "p": 581}, {"n": 48, "t": "وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ ٤٨", "p": 581}, {"n": 49, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٤٩", "p": 581}, {"n": 50, "t": "فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ ٥٠", "p": 581}]