[{"n": 1, "t": "وَٱلۡفَجۡرِ ١", "p": 593}, {"n": 2, "t": "وَلَيَالٍ عَشۡرٖ ٢", "p": 593}, {"n": 3, "t": "وَٱلشَّفۡعِ وَٱلۡوَتۡرِ ٣", "p": 593}, {"n": 4, "t": "وَٱلَّيۡلِ إِذَا يَسۡرِ ٤", "p": 593}, {"n": 5, "t": "هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ ٥", "p": 593}, {"n": 6, "t": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ ٦", "p": 593}, {"n": 7, "t": "إِرَمَ ذَاتِ ٱلۡعِمَادِ ٧", "p": 593}, {"n": 8, "t": "ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ ٨", "p": 593}, {"n": 9, "t": "وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ ٩", "p": 593}, {"n": 10, "t": "وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ ١٠", "p": 593}, {"n": 11, "t": "ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ ١١", "p": 593}, {"n": 12, "t": "فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ ١٢", "p": 593}, {"n": 13, "t": "فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ ١٣", "p": 593}, {"n": 14, "t": "إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ ١٤", "p": 593}, {"n": 15, "t": "فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ ١٥", "p": 593}, {"n": 16, "t": "وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ ١٦", "p": 593}, {"n": 17, "t": "كـَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ ١٧", "p": 593}, {"n": 18, "t": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ١٨", "p": 593}, {"n": 19, "t": "وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا ١٩", "p": 593}, {"n": 20, "t": "وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا ٢٠", "p": 593}, {"n": 21, "t": "كـَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا ٢١", "p": 593}, {"n": 22, "t": "وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا ٢٢", "p": 593}, {"n": 23, "t": "وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ ٢٣", "p": 594}, {"n": 24, "t": "يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي ٢٤", "p": 594}, {"n": 25, "t": "فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ ٢٥", "p": 594}, {"n": 26, "t": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ ٢٦", "p": 594}, {"n": 27, "t": "يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ ٢٧", "p": 594}, {"n": 28, "t": "ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ ٢٨", "p": 594}, {"n": 29, "t": "فَٱدۡخُلِي فِي عِبَٰدِي ٢٩", "p": 594}, {"n": 30, "t": "وَٱدۡخُلِي جَنَّتِي ٣٠", "p": 594}]