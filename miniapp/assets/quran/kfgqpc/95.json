[{"n": 1, "t": "وَٱلتِّينِ وَٱلزَّيۡتُونِ ١", "p": 597}, {"n": 2, "t": "وَطُورِ سِينِينَ ٢", "p": 597}, {"n": 3, "t": "وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ ٣", "p": 597}, {"n": 4, "t": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمٖ ٤", "p": 597}, {"n": 5, "t": "ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ ٥", "p": 597}, {"n": 6, "t": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ ٦", "p": 597}, {"n": 7, "t": "فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ ٧", "p": 597}, {"n": 8, "t": "أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ ٨", "p": 597}]