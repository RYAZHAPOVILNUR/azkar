[{"n": 1, "t": "إِذَا ٱلشَّمۡسُ كُوِّرَتۡ ١", "p": 586}, {"n": 2, "t": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ ٢", "p": 586}, {"n": 3, "t": "وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ ٣", "p": 586}, {"n": 4, "t": "وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ ٤", "p": 586}, {"n": 5, "t": "وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ ٥", "p": 586}, {"n": 6, "t": "وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ ٦", "p": 586}, {"n": 7, "t": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ ٧", "p": 586}, {"n": 8, "t": "وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ ٨", "p": 586}, {"n": 9, "t": "بِأَيِّ ذَنۢبٖ قُتِلَتۡ ٩", "p": 586}, {"n": 10, "t": "وَإِذَا ٱلصُّحُفُ نُشِرَتۡ ١٠", "p": 586}, {"n": 11, "t": "وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ ١١", "p": 586}, {"n": 12, "t": "وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ ١٢", "p": 586}, {"n": 13, "t": "وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ ١٣", "p": 586}, {"n": 14, "t": "عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ ١٤", "p": 586}, {"n": 15, "t": "فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ ١٥", "p": 586}, {"n": 16, "t": "ٱلۡجَوَارِ ٱلۡكُنَّسِ ١٦", "p": 586}, {"n": 17, "t": "وَٱلَّيۡلِ إِذَا عَسۡعَسَ ١٧", "p": 586}, {"n": 18, "t": "وَٱلصُّبۡحِ إِذَا تَنَفَّسَ ١٨", "p": 586}, {"n": 19, "t": "إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ ١٩", "p": 586}, {"n": 20, "t": "ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ ٢٠", "p": 586}, {"n": 21, "t": "مُّطَاعٖ ثَمَّ أَمِينٖ ٢١", "p": 586}, {"n": 22, "t": "وَمَا صَاحِبُكُم بِمَجۡنُونٖ ٢٢", "p": 586}, {"n": 23, "t": "وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ ٢٣", "p": 586}, {"n": 24, "t": "وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ ٢٤", "p": 586}, {"n": 25, "t": "وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ ٢٥", "p": 586}, {"n": 26, "t": "فَأَيۡنَ تَذۡهَبُونَ ٢٦", "p": 586}, {"n": 27, "t": "إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ ٢٧", "p": 586}, {"n": 28, "t": "لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ ٢٨", "p": 586}, {"n": 29, "t": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ ٢٩", "p": 586}]