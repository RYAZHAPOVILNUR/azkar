[{"n": 1, "t": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰ ١", "p": 595}, {"n": 2, "t": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ ٢", "p": 595}, {"n": 3, "t": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ ٣", "p": 595}, {"n": 4, "t": "إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ ٤", "p": 595}, {"n": 5, "t": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ ٥", "p": 595}, {"n": 6, "t": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ ٦", "p": 595}, {"n": 7, "t": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ ٧", "p": 595}, {"n": 8, "t": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ ٨", "p": 595}, {"n": 9, "t": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ ٩", "p": 595}, {"n": 10, "t": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ ١٠", "p": 596}, {"n": 11, "t": "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ ١١", "p": 596}, {"n": 12, "t": "إِنَّ عَلَيۡنَا لَلۡهُدَىٰ ١٢", "p": 596}, {"n": 13, "t": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ ١٣", "p": 596}, {"n": 14, "t": "فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ ١٤", "p": 596}, {"n": 15, "t": "لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى ١٥", "p": 596}, {"n": 16, "t": "ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ ١٦", "p": 596}, {"n": 17, "t": "وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى ١٧", "p": 596}, {"n": 18, "t": "ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ ١٨", "p": 596}, {"n": 19, "t": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ ١٩", "p": 596}, {"n": 20, "t": "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ ٢٠", "p": 596}, {"n": 21, "t": "وَلَسَوۡفَ يَرۡضَىٰ ٢١", "p": 596}]