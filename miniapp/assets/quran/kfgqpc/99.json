[{"n": 1, "t": "إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا ١", "p": 599}, {"n": 2, "t": "وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا ٢", "p": 599}, {"n": 3, "t": "وَقَالَ ٱلۡإِنسَٰنُ مَا لَهَا ٣", "p": 599}, {"n": 4, "t": "يَوۡمَئِذٖ تُحَدِّثُ أَخۡبَارَهَا ٤", "p": 599}, {"n": 5, "t": "بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا ٥", "p": 599}, {"n": 6, "t": "يَوۡمَئِذٖ يَصۡدُرُ ٱلنَّاسُ أَشۡتَاتٗا لِّيُرَوۡاْ أَعۡمَٰلَهُمۡ ٦", "p": 599}, {"n": 7, "t": "فَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرٗا يَرَهُۥ ٧", "p": 599}, {"n": 8, "t": "وَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٖ شَرّٗا يَرَهُۥ ٨", "p": 599}]