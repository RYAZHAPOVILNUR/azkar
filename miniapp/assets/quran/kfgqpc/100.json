[{"n": 1, "t": "وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا ١", "p": 599}, {"n": 2, "t": "فَٱلۡمُورِيَٰتِ قَدۡحٗا ٢", "p": 599}, {"n": 3, "t": "فَٱلۡمُغِيرَٰتِ صُبۡحٗا ٣", "p": 599}, {"n": 4, "t": "فَأَثَرۡنَ بِهِۦ نَقۡعٗا ٤", "p": 599}, {"n": 5, "t": "فَوَسَطۡنَ بِهِۦ جَمۡعًا ٥", "p": 599}, {"n": 6, "t": "إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ ٦", "p": 600}, {"n": 7, "t": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ ٧", "p": 600}, {"n": 8, "t": "وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ ٨", "p": 600}, {"n": 9, "t": "۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ ٩", "p": 600}, {"n": 10, "t": "وَحُصِّلَ مَا فِي ٱلصُّدُورِ ١٠", "p": 600}, {"n": 11, "t": "إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ ١١", "p": 600}]