[{"n": 1, "t": "وَٱلصَّٰٓفَّٰتِ صَفّٗا ١", "p": 446}, {"n": 2, "t": "فَٱلزَّٰجِرَٰتِ زَجۡرٗا ٢", "p": 446}, {"n": 3, "t": "فَٱلتَّٰلِيَٰتِ ذِكۡرًا ٣", "p": 446}, {"n": 4, "t": "إِنَّ إِلَٰهَكُمۡ لَوَٰحِدٞ ٤", "p": 446}, {"n": 5, "t": "رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ ٥", "p": 446}, {"n": 6, "t": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةٍ ٱلۡكَوَاكِبِ ٦", "p": 446}, {"n": 7, "t": "وَحِفۡظٗا مِّن كُلِّ شَيۡطَٰنٖ مَّارِدٖ ٧", "p": 446}, {"n": 8, "t": "لَّا يَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبٖ ٨", "p": 446}, {"n": 9, "t": "دُحُورٗاۖ وَلَهُمۡ عَذَابٞ وَاصِبٌ ٩", "p": 446}, {"n": 10, "t": "إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابٞ ثَاقِبٞ ١٠", "p": 446}, {"n": 11, "t": "فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينٖ لَّازِبِۭ ١١", "p": 446}, {"n": 12, "t": "بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ ١٢", "p": 446}, {"n": 13, "t": "وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ ١٣", "p": 446}, {"n": 14, "t": "وَإِذَا رَأَوۡاْ ءَايَةٗ يَسۡتَسۡخِرُونَ ١٤", "p": 446}, {"n": 15, "t": "وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ مُّبِينٌ ١٥", "p": 446}, {"n": 16, "t": "أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ ١٦", "p": 446}, {"n": 17, "t": "أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ ١٧", "p": 446}, {"n": 18, "t": "قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ ١٨", "p": 446}, {"n": 19, "t": "فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ فَإِذَا هُمۡ يَنظُرُونَ ١٩", "p": 446}, {"n": 20, "t": "وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ ٢٠", "p": 446}, {"n": 21, "t": "هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ ٢١", "p": 446}, {"n": 22, "t": "۞ ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ ٢٢", "p": 446}, {"n": 23, "t": "مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ ٢٣", "p": 446}, {"n": 24, "t": "وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ ٢٤", "p": 446}, {"n": 25, "t": "مَا لَكُمۡ لَا تَنَاصَرُونَ ٢٥", "p": 447}, {"n": 26, "t": "بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ ٢٦", "p": 447}, {"n": 27, "t": "وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ ٢٧", "p": 447}, {"n": 28, "t": "قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ ٢٨", "p": 447}, {"n": 29, "t": "قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ ٢٩", "p": 447}, {"n": 30, "t": "وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمٗا طَٰغِينَ ٣٠", "p": 447}, {"n": 31, "t": "فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ ٣١", "p": 447}, {"n": 32, "t": "فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ ٣٢", "p": 447}, {"n": 33, "t": "فَإِنَّهُمۡ يَوۡمَئِذٖ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ ٣٣", "p": 447}, {"n": 34, "t": "إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ ٣٤", "p": 447}, {"n": 35, "t": "إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ ٣٥", "p": 447}, {"n": 36, "t": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجۡنُونِۭ ٣٦", "p": 447}, {"n": 37, "t": "بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ ٣٧", "p": 447}, {"n": 38, "t": "إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ ٣٨", "p": 447}, {"n": 39, "t": "وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ ٣٩", "p": 447}, {"n": 40, "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ٤٠", "p": 447}, {"n": 41, "t": "أُوْلَٰٓئِكَ لَهُمۡ رِزۡقٞ مَّعۡلُومٞ ٤١", "p": 447}, {"n": 42, "t": "فَوَٰكِهُ وَهُم مُّكۡرَمُونَ ٤٢", "p": 447}, {"n": 43, "t": "فِي جَنَّٰتِ ٱلنَّعِيمِ ٤٣", "p": 447}, {"n": 44, "t": "عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ ٤٤", "p": 447}, {"n": 45, "t": "يُطَافُ عَلَيۡهِم بِكَأۡسٖ مِّن مَّعِينِۭ ٤٥", "p": 447}, {"n": 46, "t": "بَيۡضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ ٤٦", "p": 447}, {"n": 47, "t": "لَا فِيهَا غَوۡلٞ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ ٤٧", "p": 447}, {"n": 48, "t": "وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينٞ ٤٨", "p": 447}, {"n": 49, "t": "كَأَنَّهُنَّ بَيۡضٞ مَّكۡنُونٞ ٤٩", "p": 447}, {"n": 50, "t": "فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ ٥٠", "p": 447}, {"n": 51, "t": "قَالَ قَآئِلٞ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينٞ ٥١", "p": 447}, {"n": 52, "t": "يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ ٥٢", "p": 448}, {"n": 53, "t": "أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ ٥٣", "p": 448}, {"n": 54, "t": "قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ ٥٤", "p": 448}, {"n": 55, "t": "فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ ٥٥", "p": 448}, {"n": 56, "t": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ ٥٦", "p": 448}, {"n": 57, "t": "وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ ٥٧", "p": 448}, {"n": 58, "t": "أَفَمَا نَحۡنُ بِمَيِّتِينَ ٥٨", "p": 448}, {"n": 59, "t": "إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ ٥٩", "p": 448}, {"n": 60, "t": "إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ ٦٠", "p": 448}, {"n": 61, "t": "لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ ٦١", "p": 448}, {"n": 62, "t": "أَذَٰلِكَ خَيۡرٞ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ ٦٢", "p": 448}, {"n": 63, "t": "إِنَّا جَعَلۡنَٰهَا فِتۡنَةٗ لِّلظَّٰلِمِينَ ٦٣", "p": 448}, {"n": 64, "t": "إِنَّهَا شَجَرَةٞ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ ٦٤", "p": 448}, {"n": 65, "t": "طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ ٦٥", "p": 448}, {"n": 66, "t": "فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ ٦٦", "p": 448}, {"n": 67, "t": "ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبٗا مِّنۡ حَمِيمٖ ٦٧", "p": 448}, {"n": 68, "t": "ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ ٦٨", "p": 448}, {"n": 69, "t": "إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ ٦٩", "p": 448}, {"n": 70, "t": "فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ ٧٠", "p": 448}, {"n": 71, "t": "وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ ٧١", "p": 448}, {"n": 72, "t": "وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ ٧٢", "p": 448}, {"n": 73, "t": "فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ ٧٣", "p": 448}, {"n": 74, "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ٧٤", "p": 448}, {"n": 75, "t": "وَلَقَدۡ نَادَىٰنَا نُوحٞ فَلَنِعۡمَ ٱلۡمُجِيبُونَ ٧٥", "p": 448}, {"n": 76, "t": "وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ ٧٦", "p": 448}, {"n": 77, "t": "وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ ٱلۡبَاقِينَ ٧٧", "p": 449}, {"n": 78, "t": "وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ ٧٨", "p": 449}, {"n": 79, "t": "سَلَٰمٌ عَلَىٰ نُوحٖ فِي ٱلۡعَٰلَمِينَ ٧٩", "p": 449}, {"n": 80, "t": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ٨٠", "p": 449}, {"n": 81, "t": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ٨١", "p": 449}, {"n": 82, "t": "ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ ٨٢", "p": 449}, {"n": 83, "t": "۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبۡرَٰهِيمَ ٨٣", "p": 449}, {"n": 84, "t": "إِذۡ جَآءَ رَبَّهُۥ بِقَلۡبٖ سَلِيمٍ ٨٤", "p": 449}, {"n": 85, "t": "إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَاذَا تَعۡبُدُونَ ٨٥", "p": 449}, {"n": 86, "t": "أَئِفۡكًا ءَالِهَةٗ دُونَ ٱللَّهِ تُرِيدُونَ ٨٦", "p": 449}, {"n": 87, "t": "فَمَا ظَنُّكُم بِرَبِّ ٱلۡعَٰلَمِينَ ٨٧", "p": 449}, {"n": 88, "t": "فَنَظَرَ نَظۡرَةٗ فِي ٱلنُّجُومِ ٨٨", "p": 449}, {"n": 89, "t": "فَقَالَ إِنِّي سَقِيمٞ ٨٩", "p": 449}, {"n": 90, "t": "فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ ٩٠", "p": 449}, {"n": 91, "t": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ ٩١", "p": 449}, {"n": 92, "t": "مَا لَكُمۡ لَا تَنطِقُونَ ٩٢", "p": 449}, {"n": 93, "t": "فَرَاغَ عَلَيۡهِمۡ ضَرۡبَۢا بِٱلۡيَمِينِ ٩٣", "p": 449}, {"n": 94, "t": "فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ ٩٤", "p": 449}, {"n": 95, "t": "قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ ٩٥", "p": 449}, {"n": 96, "t": "وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ ٩٦", "p": 449}, {"n": 97, "t": "قَالُواْ ٱبۡنُواْ لَهُۥ بُنۡيَٰنٗا فَأَلۡقُوهُ فِي ٱلۡجَحِيمِ ٩٧", "p": 449}, {"n": 98, "t": "فَأَرَادُواْ بِهِۦ كَيۡدٗا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ ٩٨", "p": 449}, {"n": 99, "t": "وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهۡدِينِ ٩٩", "p": 449}, {"n": 100, "t": "رَبِّ هَبۡ لِي مِنَ ٱلصَّٰلِحِينَ ١٠٠", "p": 449}, {"n": 101, "t": "فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمٖ ١٠١", "p": 449}, {"n": 102, "t": "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡيَ قَالَ يَٰبُنَيَّ إِنِّيٓ أَرَىٰ فِي ٱلۡمَنَامِ أَنِّيٓ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ يَٰٓأَبَتِ ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ ١٠٢", "p": 449}, {"n": 103, "t": "فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ ١٠٣", "p": 450}, {"n": 104, "t": "وَنَٰدَيۡنَٰهُ أَن يَٰٓإِبۡرَٰهِيمُ ١٠٤", "p": 450}, {"n": 105, "t": "قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ١٠٥", "p": 450}, {"n": 106, "t": "إِنَّ هَٰذَا لَهُوَ ٱلۡبَلَٰٓؤُاْ ٱلۡمُبِينُ ١٠٦", "p": 450}, {"n": 107, "t": "وَفَدَيۡنَٰهُ بِذِبۡحٍ عَظِيمٖ ١٠٧", "p": 450}, {"n": 108, "t": "وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ ١٠٨", "p": 450}, {"n": 109, "t": "سَلَٰمٌ عَلَىٰٓ إِبۡرَٰهِيمَ ١٠٩", "p": 450}, {"n": 110, "t": "كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ١١٠", "p": 450}, {"n": 111, "t": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ١١١", "p": 450}, {"n": 112, "t": "وَبَشَّرۡنَٰهُ بِإِسۡحَٰقَ نَبِيّٗا مِّنَ ٱلصَّٰلِحِينَ ١١٢", "p": 450}, {"n": 113, "t": "وَبَٰرَكۡنَا عَلَيۡهِ وَعَلَىٰٓ إِسۡحَٰقَۚ وَمِن ذُرِّيَّتِهِمَا مُحۡسِنٞ وَظَالِمٞ لِّنَفۡسِهِۦ مُبِينٞ ١١٣", "p": 450}, {"n": 114, "t": "وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ ١١٤", "p": 450}, {"n": 115, "t": "وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ ١١٥", "p": 450}, {"n": 116, "t": "وَنَصَرۡنَٰهُمۡ فَكَانُواْ هُمُ ٱلۡغَٰلِبِينَ ١١٦", "p": 450}, {"n": 117, "t": "وَءَاتَيۡنَٰهُمَا ٱلۡكِتَٰبَ ٱلۡمُسۡتَبِينَ ١١٧", "p": 450}, {"n": 118, "t": "وَهَدَيۡنَٰهُمَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ ١١٨", "p": 450}, {"n": 119, "t": "وَتَرَكۡنَا عَلَيۡهِمَا فِي ٱلۡأٓخِرِينَ ١١٩", "p": 450}, {"n": 120, "t": "سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ ١٢٠", "p": 450}, {"n": 121, "t": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ١٢١", "p": 450}, {"n": 122, "t": "إِنَّهُمَا مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ١٢٢", "p": 450}, {"n": 123, "t": "وَإِنَّ إِلۡيَاسَ لَمِنَ ٱلۡمُرۡسَلِينَ ١٢٣", "p": 450}, {"n": 124, "t": "إِذۡ قَالَ لِقَوۡمِهِۦٓ أَلَا تَتَّقُونَ ١٢٤", "p": 450}, {"n": 125, "t": "أَتَدۡعُونَ بَعۡلٗا وَتَذَرُونَ أَحۡسَنَ ٱلۡخَٰلِقِينَ ١٢٥", "p": 450}, {"n": 126, "t": "ٱللَّهَ رَبَّكُمۡ وَرَبَّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ ١٢٦", "p": 450}, {"n": 127, "t": "فَكَذَّبُوهُ فَإِنَّهُمۡ لَمُحۡضَرُونَ ١٢٧", "p": 451}, {"n": 128, "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ١٢٨", "p": 451}, {"n": 129, "t": "وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ ١٢٩", "p": 451}, {"n": 130, "t": "سَلَٰمٌ عَلَىٰٓ إِلۡ يَاسِينَ ١٣٠", "p": 451}, {"n": 131, "t": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ١٣١", "p": 451}, {"n": 132, "t": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ١٣٢", "p": 451}, {"n": 133, "t": "وَإِنَّ لُوطٗا لَّمِنَ ٱلۡمُرۡسَلِينَ ١٣٣", "p": 451}, {"n": 134, "t": "إِذۡ نَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ ١٣٤", "p": 451}, {"n": 135, "t": "إِلَّا عَجُوزٗا فِي ٱلۡغَٰبِرِينَ ١٣٥", "p": 451}, {"n": 136, "t": "ثُمَّ دَمَّرۡنَا ٱلۡأٓخَرِينَ ١٣٦", "p": 451}, {"n": 137, "t": "وَإِنَّكُمۡ لَتَمُرُّونَ عَلَيۡهِم مُّصۡبِحِينَ ١٣٧", "p": 451}, {"n": 138, "t": "وَبِٱلَّيۡلِۚ أَفَلَا تَعۡقِلُونَ ١٣٨", "p": 451}, {"n": 139, "t": "وَإِنَّ يُونُسَ لَمِنَ ٱلۡمُرۡسَلِينَ ١٣٩", "p": 451}, {"n": 140, "t": "إِذۡ أَبَقَ إِلَى ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ ١٤٠", "p": 451}, {"n": 141, "t": "فَسَاهَمَ فَكَانَ مِنَ ٱلۡمُدۡحَضِينَ ١٤١", "p": 451}, {"n": 142, "t": "فَٱلۡتَقَمَهُ ٱلۡحُوتُ وَهُوَ مُلِيمٞ ١٤٢", "p": 451}, {"n": 143, "t": "فَلَوۡلَآ أَنَّهُۥ كَانَ مِنَ ٱلۡمُسَبِّحِينَ ١٤٣", "p": 451}, {"n": 144, "t": "لَلَبِثَ فِي بَطۡنِهِۦٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ ١٤٤", "p": 451}, {"n": 145, "t": "۞ فَنَبَذۡنَٰهُ بِٱلۡعَرَآءِ وَهُوَ سَقِيمٞ ١٤٥", "p": 451}, {"n": 146, "t": "وَأَنۢبَتۡنَا عَلَيۡهِ شَجَرَةٗ مِّن يَقۡطِينٖ ١٤٦", "p": 451}, {"n": 147, "t": "وَأَرۡسَلۡنَٰهُ إِلَىٰ مِاْئَةِ أَلۡفٍ أَوۡ يَزِيدُونَ ١٤٧", "p": 451}, {"n": 148, "t": "فَـَٔامَنُواْ فَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينٖ ١٤٨", "p": 451}, {"n": 149, "t": "فَٱسۡتَفۡتِهِمۡ أَلِرَبِّكَ ٱلۡبَنَاتُ وَلَهُمُ ٱلۡبَنُونَ ١٤٩", "p": 451}, {"n": 150, "t": "أَمۡ خَلَقۡنَا ٱلۡمَلَٰٓئِكَةَ إِنَٰثٗا وَهُمۡ شَٰهِدُونَ ١٥٠", "p": 451}, {"n": 151, "t": "أَلَآ إِنَّهُم مِّنۡ إِفۡكِهِمۡ لَيَقُولُونَ ١٥١", "p": 451}, {"n": 152, "t": "وَلَدَ ٱللَّهُ وَإِنَّهُمۡ لَكَٰذِبُونَ ١٥٢", "p": 451}, {"n": 153, "t": "أَصۡطَفَى ٱلۡبَنَاتِ عَلَى ٱلۡبَنِينَ ١٥٣", "p": 451}, {"n": 154, "t": "مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ ١٥٤", "p": 452}, {"n": 155, "t": "أَفَلَا تَذَكَّرُونَ ١٥٥", "p": 452}, {"n": 156, "t": "أَمۡ لَكُمۡ سُلۡطَٰنٞ مُّبِينٞ ١٥٦", "p": 452}, {"n": 157, "t": "فَأۡتُواْ بِكِتَٰبِكُمۡ إِن كُنتُمۡ صَٰدِقِينَ ١٥٧", "p": 452}, {"n": 158, "t": "وَجَعَلُواْ بَيۡنَهُۥ وَبَيۡنَ ٱلۡجِنَّةِ نَسَبٗاۚ وَلَقَدۡ عَلِمَتِ ٱلۡجِنَّةُ إِنَّهُمۡ لَمُحۡضَرُونَ ١٥٨", "p": 452}, {"n": 159, "t": "سُبۡحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ ١٥٩", "p": 452}, {"n": 160, "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ١٦٠", "p": 452}, {"n": 161, "t": "فَإِنَّكُمۡ وَمَا تَعۡبُدُونَ ١٦١", "p": 452}, {"n": 162, "t": "مَآ أَنتُمۡ عَلَيۡهِ بِفَٰتِنِينَ ١٦٢", "p": 452}, {"n": 163, "t": "إِلَّا مَنۡ هُوَ صَالِ ٱلۡجَحِيمِ ١٦٣", "p": 452}, {"n": 164, "t": "وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٞ مَّعۡلُومٞ ١٦٤", "p": 452}, {"n": 165, "t": "وَإِنَّا لَنَحۡنُ ٱلصَّآفُّونَ ١٦٥", "p": 452}, {"n": 166, "t": "وَإِنَّا لَنَحۡنُ ٱلۡمُسَبِّحُونَ ١٦٦", "p": 452}, {"n": 167, "t": "وَإِن كَانُواْ لَيَقُولُونَ ١٦٧", "p": 452}, {"n": 168, "t": "لَوۡ أَنَّ عِندَنَا ذِكۡرٗا مِّنَ ٱلۡأَوَّلِينَ ١٦٨", "p": 452}, {"n": 169, "t": "لَكُنَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ١٦٩", "p": 452}, {"n": 170, "t": "فَكَفَرُواْ بِهِۦۖ فَسَوۡفَ يَعۡلَمُونَ ١٧٠", "p": 452}, {"n": 171, "t": "وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا ٱلۡمُرۡسَلِينَ ١٧١", "p": 452}, {"n": 172, "t": "إِنَّهُمۡ لَهُمُ ٱلۡمَنصُورُونَ ١٧٢", "p": 452}, {"n": 173, "t": "وَإِنَّ جُندَنَا لَهُمُ ٱلۡغَٰلِبُونَ ١٧٣", "p": 452}, {"n": 174, "t": "فَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ ١٧٤", "p": 452}, {"n": 175, "t": "وَأَبۡصِرۡهُمۡ فَسَوۡفَ يُبۡصِرُونَ ١٧٥", "p": 452}, {"n": 176, "t": "أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ ١٧٦", "p": 452}, {"n": 177, "t": "فَإِذَا نَزَلَ بِسَاحَتِهِمۡ فَسَآءَ صَبَاحُ ٱلۡمُنذَرِينَ ١٧٧", "p": 452}, {"n": 178, "t": "وَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ ١٧٨", "p": 452}, {"n": 179, "t": "وَأَبۡصِرۡ فَسَوۡفَ يُبۡصِرُونَ ١٧٩", "p": 452}, {"n": 180, "t": "سُبۡحَٰنَ رَبِّكَ رَبِّ ٱلۡعِزَّةِ عَمَّا يَصِفُونَ ١٨٠", "p": 452}, {"n": 181, "t": "وَسَلَٰمٌ عَلَى ٱلۡمُرۡسَلِينَ ١٨١", "p": 452}, {"n": 182, "t": "وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ ١٨٢", "p": 452}]