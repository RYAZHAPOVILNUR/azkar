[{"n": 1, "t": "ٱلۡقَارِعَةُ ١", "p": 600}, {"n": 2, "t": "مَا ٱلۡقَارِعَةُ ٢", "p": 600}, {"n": 3, "t": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ ٣", "p": 600}, {"n": 4, "t": "يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ ٤", "p": 600}, {"n": 5, "t": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ ٥", "p": 600}, {"n": 6, "t": "فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ ٦", "p": 600}, {"n": 7, "t": "فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ ٧", "p": 600}, {"n": 8, "t": "وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ ٨", "p": 600}, {"n": 9, "t": "فَأُمُّهُۥ هَاوِيَةٞ ٩", "p": 600}, {"n": 10, "t": "وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ ١٠", "p": 600}, {"n": 11, "t": "نَارٌ حَامِيَةُۢ ١١", "p": 600}]