[{"n": 1, "t": "لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ ١", "p": 594}, {"n": 2, "t": "وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ ٢", "p": 594}, {"n": 3, "t": "وَوَالِدٖ وَمَا وَلَدَ ٣", "p": 594}, {"n": 4, "t": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ ٤", "p": 594}, {"n": 5, "t": "أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدٞ ٥", "p": 594}, {"n": 6, "t": "يَقُولُ أَهۡلَكۡتُ مَالٗا لُّبَدًا ٦", "p": 594}, {"n": 7, "t": "أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ ٧", "p": 594}, {"n": 8, "t": "أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ ٨", "p": 594}, {"n": 9, "t": "وَلِسَانٗا وَشَفَتَيۡنِ ٩", "p": 594}, {"n": 10, "t": "وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ ١٠", "p": 594}, {"n": 11, "t": "فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ ١١", "p": 594}, {"n": 12, "t": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ ١٢", "p": 594}, {"n": 13, "t": "فَكُّ رَقَبَةٍ ١٣", "p": 594}, {"n": 14, "t": "أَوۡ إِطۡعَٰمٞ فِي يَوۡمٖ ذِي مَسۡغَبَةٖ ١٤", "p": 594}, {"n": 15, "t": "يَتِيمٗا ذَا مَقۡرَبَةٍ ١٥", "p": 594}, {"n": 16, "t": "أَوۡ مِسۡكِينٗا ذَا مَتۡرَبَةٖ ١٦", "p": 594}, {"n": 17, "t": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ ١٧", "p": 594}, {"n": 18, "t": "أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ ١٨", "p": 594}, {"n": 19, "t": "وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ ١٩", "p": 595}, {"n": 20, "t": "عَلَيۡهِمۡ نَارٞ مُّؤۡصَدَةُۢ ٢٠", "p": 595}]