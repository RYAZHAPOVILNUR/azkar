[{"n": 1, "t": "وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ ١", "p": 601}, {"n": 2, "t": "ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ ٢", "p": 601}, {"n": 3, "t": "يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ ٣", "p": 601}, {"n": 4, "t": "كـَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ ٤", "p": 601}, {"n": 5, "t": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ ٥", "p": 601}, {"n": 6, "t": "نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ ٦", "p": 601}, {"n": 7, "t": "ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ ٧", "p": 601}, {"n": 8, "t": "إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ ٨", "p": 601}, {"n": 9, "t": "فِي عَمَدٖ مُّمَدَّدَةِۭ ٩", "p": 601}]