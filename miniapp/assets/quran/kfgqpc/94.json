[{"n": 1, "t": "أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ ١", "p": 596}, {"n": 2, "t": "وَوَضَعۡنَا عَنكَ وِزۡرَكَ ٢", "p": 596}, {"n": 3, "t": "ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ ٣", "p": 597}, {"n": 4, "t": "وَرَفَعۡنَا لَكَ ذِكۡرَكَ ٤", "p": 597}, {"n": 5, "t": "فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا ٥", "p": 597}, {"n": 6, "t": "إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا ٦", "p": 597}, {"n": 7, "t": "فَإِذَا فَرَغۡتَ فَٱنصَبۡ ٧", "p": 597}, {"n": 8, "t": "وَإِلَىٰ رَبِّكَ فَٱرۡغَب ٨", "p": 597}]