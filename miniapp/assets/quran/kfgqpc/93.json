[{"n": 1, "t": "وَٱلضُّحَىٰ ١", "p": 596}, {"n": 2, "t": "وَٱلَّيۡلِ إِذَا سَجَىٰ ٢", "p": 596}, {"n": 3, "t": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ ٣", "p": 596}, {"n": 4, "t": "وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ ٤", "p": 596}, {"n": 5, "t": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ ٥", "p": 596}, {"n": 6, "t": "أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ ٦", "p": 596}, {"n": 7, "t": "وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ ٧", "p": 596}, {"n": 8, "t": "وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ ٨", "p": 596}, {"n": 9, "t": "فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ ٩", "p": 596}, {"n": 10, "t": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ ١٠", "p": 596}, {"n": 11, "t": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ ١١", "p": 596}]