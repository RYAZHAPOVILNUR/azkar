{"n":96,"na":"سُورَةُ العَلَقِ","ne":"Al-Alaq","nr":"Аль-Аляк","nm":"Сгусток","t":"мекканская","c":19,"bism":true,"a":[{"n":1,"ar":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","tj":"ٱ[q:7699[قْ]رَأْ بِ[h:13285[ٱ]سْمِ رَبِّكَ [h:14559[ٱ]لَّذِى خَلَ[q[ق]َ","ru":"Читай во имя твоего Господа, Который сотворил все сущее,"},{"n":2,"ar":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","tj":"خَلَقَ [h:7324[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مِنْ عَلَ[q[ق]ٍ","ru":"сотворил человека из сгустка крови."},{"n":3,"ar":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","tj":"ٱ[q:7699[قْ]رَأْ وَرَبُّكَ [h:14560[ٱ]لْأَكْرَمُ","ru":"Читай, ведь твой Господь - Самый великодушный."},{"n":4,"ar":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","tj":"ٱلَّذِى عَلَّمَ بِ[h:14561[ٱ]لْقَلَمِ","ru":"Он научил посредством письменной трости -"},{"n":5,"ar":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ","tj":"عَلَّمَ [h:14562[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مَا لَمْ يَعْلَمْ","ru":"научил человека тому, чего тот не знал."},{"n":6,"ar":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","tj":"كَلّ[o[َآ] إِ[g[نّ]َ [h:7137[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ لَيَ[q:14563[طْ]غَىٰٓ","ru":"Но нет! Человек преступает границы дозволенного,"},{"n":7,"ar":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","tj":"أ[u:14564[َن ر]َّءَاهُ [h:14565[ٱ]سْتَغْنَىٰٓ","ru":"когда ему кажется, что он ни в чем не нуждается."},{"n":8,"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","tj":"إِ[g[نّ]َ إِلَىٰ رَبِّكَ [h:14566[ٱ][l[ل]رُّ[q:14567[جْ]عَىٰٓ","ru":"Но к твоему Господу предстоит возвращение."},{"n":9,"ar":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","tj":"أَرَءَيْتَ [h:14568[ٱ]لَّذِى يَنْهَىٰ","ru":"Что ты думаешь о том, кто мешает"},{"n":10,"ar":"عَبْدًا إِذَا صَلَّىٰٓ","tj":"عَ[q:3317[بْ]دًا إِذَا صَلَّىٰٓ","ru":"рабу, когда тот молится?"},{"n":11,"ar":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","tj":"أَرَءَيْتَ إِ[f:2594[ن ك]َانَ عَلَى [h:4019[ٱ]لْهُدَىٰٓ","ru":"Что ты думаешь, а если он был на правом пути"},{"n":12,"ar":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","tj":"أَوْ أَمَرَ بِ[h:14569[ٱ][l[ل]تَّ[q:14569[قْ]وَىٰٓ","ru":"или призывал к богобоязненности?"},{"n":13,"ar":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","tj":"أَرَءَيْتَ إِ[f:14570[ن ك]َذَّبَ وَتَوَلَّىٰٓ","ru":"Что ты думаешь, а если он счел ложью истину и отвернулся?"},{"n":14,"ar":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","tj":"أَلَمْ يَعْل[c:14571[َم ب]ِأَ[g[نّ]َ [h:897[ٱ]للَّهَ يَرَىٰ","ru":"Неужели он не знал, что Аллах видит его?"},{"n":15,"ar":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعَۢا بِٱلنَّاصِيَةِ","tj":"كَلَّا لَئ[u:4195[ِن ل]َّمْ يَ[f:10891[نت]َهِ لَنَسْفَع[i:14572[َۢا ب]ِ[h:14573[ٱ][l[ل][g[نّ]َاصِيَةِ","ru":"Но нет, если он не перестанет, то Мы схватим его за хохол -"},{"n":16,"ar":"نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ","tj":"نَاصِيَ[f:14574[ةٍ ك]َ[n[ـٰ]ذِبَةٍ خَاطِئَةٍ","ru":"хохол лживый, грешный."},{"n":17,"ar":"فَلْيَدْعُ نَادِيَهُۥ","tj":"فَلْيَ[q:14575[دْ]عُ نَادِيَهُۥ","ru":"Пусть он зовет свое сборище."},{"n":18,"ar":"سَنَدْعُ ٱلزَّبَانِيَةَ","tj":"سَنَ[q:14576[دْ]عُ [h:14577[ٱ][l[ل]زَّبَانِيَةَ","ru":"Мы же позовем адских стражей!"},{"n":19,"ar":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","tj":"كَلَّا لَا تُطِعْهُ وَ[h:14578[ٱ]سْجُ[q:14578[دْ] وَ[h:14579[ٱ][q:14579[قْ]تَرِ[q[ب] ۩","ru":"Так нет! Не повинуйся ему, а пади ниц и приближайся к Аллаху."}]}