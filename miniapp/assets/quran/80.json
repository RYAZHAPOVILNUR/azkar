{"n":80,"na":"سُورَةُ عَبَسَ","ne":"Abasa","nr":"Абаса","nm":"Нахмурился","t":"мекканская","c":42,"bism":true,"a":[{"n":1,"ar":"عَبَسَ وَتَوَلَّىٰٓ","tj":"عَبَسَ وَتَوَلَّىٰٓ","ru":"Он нахмурился и отвернулся,"},{"n":2,"ar":"أَن جَآءَهُ ٱلْأَعْمَىٰ","tj":"أَ[f:14298[ن ج][o[َا]ٓءَهُ [h:14299[ٱ]لْأَعْمَىٰ","ru":"потому что к нему подошел слепой."},{"n":3,"ar":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","tj":"وَمَا يُ[q:10898[دْ]رِيكَ لَعَلَّهُ[n[ۥ] يَزَّكَّىٰٓ","ru":"Откуда тебе знать? Возможно, он бы очистился"},{"n":4,"ar":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","tj":"أَوْ يَذَّكَّرُ فَتَ[f:14300[نف]َعَهُ [h:14301[ٱ][l[ل]ذِّكْرَىٰٓ","ru":"или помянул бы наставление, и поминание принесло бы ему пользу."},{"n":5,"ar":"أَمَّا مَنِ ٱسْتَغْنَىٰ","tj":"أَ[g[مّ]َا مَنِ [h:14302[ٱ]سْتَغْنَىٰ","ru":"Тому, кто решил, что он ни в чем не нуждается,"},{"n":6,"ar":"فَأَنتَ لَهُۥ تَصَدَّىٰ","tj":"فَأَ[f:14303[نت]َ لَهُ[n[ۥ] تَصَدَّىٰ","ru":"ты уделяешь внимание,"},{"n":7,"ar":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","tj":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","ru":"Что же будет тебе, если он не очистится?"},{"n":8,"ar":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","tj":"وَأَ[g[مّ]َا مَ[f:14304[ن ج][o[َا]ٓءَكَ يَسْعَىٰ","ru":"А того, кто приходит к тебе со рвением"},{"n":9,"ar":"وَهُوَ يَخْشَىٰ","tj":"وَهُوَ يَخْشَىٰ","ru":"и страшится Аллаха,"},{"n":10,"ar":"فَأَنتَ عَنْهُ تَلَهَّىٰ","tj":"فَأَ[f:14303[نت]َ عَنْهُ تَلَهَّىٰ","ru":"ты оставляешь без внимания."},{"n":11,"ar":"كَلَّآ إِنَّهَا تَذْكِرَةٌ","tj":"كَلّ[o[َآ] إِ[g[نّ]َهَا تَذْكِرَةٌ","ru":"Но нет! Это есть Назидание,"},{"n":12,"ar":"فَمَن شَآءَ ذَكَرَهُۥ","tj":"فَمَ[f:8041[ن ش][o[َا]ٓءَ ذَكَرَهُۥ","ru":"и пусть помянет его всякий желающий."},{"n":13,"ar":"فِى صُحُفٍ مُّكَرَّمَةٍ","tj":"فِى صُحُ[a:14305[فٍ م]ُّكَرَّمَةٍ","ru":"Оно записано в свитках почитаемых,"},{"n":14,"ar":"مَّرْفُوعَةٍ مُّطَهَّرَةِۭ","tj":"مَّرْفُوعَ[a:14306[ةٍ م]ُّطَهَّرَةِۭ","ru":"вознесенных и очищенных,"},{"n":15,"ar":"بِأَيْدِى سَفَرَةٍ","tj":"بِأَيْدِى سَفَرَةٍ","ru":"в руках посланцев"},{"n":16,"ar":"كِرَامِۭ بَرَرَةٍ","tj":"كِرَا[i:14307[مِۭ ب]َرَرَةٍ","ru":"благородных и покорных."},{"n":17,"ar":"قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ","tj":"قُتِلَ [h:14308[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ م[o[َآ] أَكْفَرَهُۥ","ru":"Да сгинет человек! Как же он неблагодарен!"},{"n":18,"ar":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","tj":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","ru":"Из чего Он сотворил его?"},{"n":19,"ar":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","tj":"م[a:7325[ِن ن]ُّ[q:7326[طْ]فَةٍ خَلَقَهُ[n[ۥ] فَقَدَّرَهُۥ","ru":"Он сотворил его из капли и соразмерил (или предопределил стадии его развития),"},{"n":20,"ar":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","tj":"ثُ[g[مّ]َ [h:14309[ٱ][l[ل]سَّبِيلَ يَسَّرَهُۥ","ru":"потом облегчил ему путь,"},{"n":21,"ar":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","tj":"ثُ[g[مّ]َ أَمَاتَهُ[n[ۥ] فَأَ[q:14310[قْ]بَرَهُۥ","ru":"потом умертвил его и поместил в могилу."},{"n":22,"ar":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","tj":"ثُ[g[مّ]َ إِذَا ش[o[َا]ٓءَ أَ[f:14311[نش]َرَهُۥ","ru":"Потом, когда пожелает, Он воскресит его."},{"n":23,"ar":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","tj":"كَلَّا لَ[g[مّ]َا يَ[q:14312[قْ]ضِ م[o[َآ] أَمَرَهُۥ","ru":"Но нет! Он не выполняет того, что Он приказал ему."},{"n":24,"ar":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ","tj":"فَلْيَ[f:14313[نظ]ُرِ [h:14314[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ إِلَىٰ طَعَامِهِۦٓ","ru":"Пусть посмотрит человек на свое пропитание!"},{"n":25,"ar":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا","tj":"أَ[g[نّ]َا صَبَ[q:14315[بْ]نَا [h:14316[ٱ]لْم[o[َا]ٓءَ صَبًّا","ru":"Мы проливаем обильные ливни,"},{"n":26,"ar":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا","tj":"ثُ[g[مّ]َ شَقَ[q:14317[قْ]نَا [h:14318[ٱ]لْأَرْضَ شَقًّا","ru":"затем рассекаем землю трещинами"},{"n":27,"ar":"فَأَنۢبَتْنَا فِيهَا حَبًّا","tj":"فَأَ[i:9998[نۢب]َتْنَا فِيهَا حَبًّا","ru":"и взращиваем на ней зерна,"},{"n":28,"ar":"وَعِنَبًا وَقَضْبًا","tj":"وَعِنَ[a:14319[بًا و]َقَضْبًا","ru":"виноград и люцерну,"},{"n":29,"ar":"وَزَيْتُونًا وَنَخْلاً","tj":"وَزَيْتُو[a:14320[نًا و]َنَخْلاً","ru":"маслины и финиковые пальмы,"},{"n":30,"ar":"وَحَدَآئِقَ غُلْبًا","tj":"وَحَد[o[َا]ٓئِقَ غُلْبًا","ru":"сады густые (или с могучими деревьями),"},{"n":31,"ar":"وَفَـٰكِهَةً وَأَبًّا","tj":"وَفَ[n[ـٰ]كِهَ[a:14321[ةً و]َأَبًّا","ru":"фрукты и травы"},{"n":32,"ar":"مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ","tj":"مَّتَ[n[ـٰ][u:3808[عًا ل]َّكُمْ وَلِأَنْعَ[n[ـٰ]مِكُمْ","ru":"на пользу вам и вашей скотине."},{"n":33,"ar":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","tj":"فَإِذَا ج[o[َا]ٓءَتِ [h:14322[ٱ][l[ل]صّ[m[َا]ٓخَّةُ","ru":"Когда же раздастся Оглушительный глас,"},{"n":34,"ar":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","tj":"يَوْمَ يَفِرُّ [h:14323[ٱ]لْمَرْءُ مِنْ أَخ[p[ِي]هِ","ru":"в тот день человек бросит своего брата,"},{"n":35,"ar":"وَأُمِّهِۦ وَأَبِيهِ","tj":"وَأُ[g[مّ]ِه[n[ِۦ] وَأَب[p[ِي]هِ","ru":"свою мать и своего отца,"},{"n":36,"ar":"وَصَـٰحِبَتِهِۦ وَبَنِيهِ","tj":"وَصَ[n[ـٰ]حِبَتِه[n[ِۦ] وَبَن[p[ِي]هِ","ru":"свою жену и своих сыновей,"},{"n":37,"ar":"لِكُلِّ ٱمْرِىٍٕ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ","tj":"لِكُلِّ [h:9345[ٱ]مْرِى[a:9346[ٍٕ م]ِّنْهُمْ يَوْمَئِ[f:14324[ذٍ ش]َأْ[a:14325[نٌ ي]ُغْن[p[ِي]هِ","ru":"ибо у каждого человека своих забот будет сполна."},{"n":38,"ar":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ","tj":"وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14326[ذٍ م]ُّسْفِرَةٌ","ru":"В тот день одни лица будут сиять,"},{"n":39,"ar":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ","tj":"ضَاحِكَ[a:14327[ةٌ م]ُّسْتَ[q:14328[بْ]شِرَةٌ","ru":"смеяться и ликовать."},{"n":40,"ar":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ","tj":"وَوُجُو[a:14137[هٌ ي]َوْمَئِذٍ عَلَيْهَا غَبَرَةٌ","ru":"На других же лицах в тот день будет прах,"},{"n":41,"ar":"تَرْهَقُهَا قَتَرَةٌ","tj":"تَرْهَقُهَا قَتَرَةٌ","ru":"покрывающий их мраком."},{"n":42,"ar":"أُوْلَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","tj":"أُ[s[وْ]لَ[o[ـٰٓ]ئِكَ هُمُ [h:14329[ٱ]لْكَفَرَةُ [h:14330[ٱ]لْفَجَرَةُ","ru":"Это будут неверующие грешники."}]}