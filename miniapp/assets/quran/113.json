{"n":113,"na":"سُورَةُ الفَلَقِ","ne":"Al-Falaq","nr":"Аль-Фаляк","nm":"Рассвет","t":"мекканская","c":5,"bism":true,"a":[{"n":1,"ar":"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","tj":"قُلْ أَعُوذُ بِرَبِّ [h:14678[ٱ]لْفَلَ[q[ق]ِ","ru":"Скажи: «Прибегаю к защите Господа рассвета"},{"n":2,"ar":"مِن شَرِّ مَا خَلَقَ","tj":"مِ[f:14679[ن ش]َرِّ مَا خَلَ[q[ق]َ","ru":"от зла того, что Он сотворил,"},{"n":3,"ar":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","tj":"وَمِ[f:14680[ن ش]َرِّ غَاسِقٍ إِذَا وَقَ[q[ب]َ","ru":"от зла мрака, когда он наступает,"},{"n":4,"ar":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ","tj":"وَمِ[f:14680[ن ش]َرِّ [h:14681[ٱ][l[ل][g[نّ]َفَّ[n[ـٰ]ثَ[n[ـٰ]تِ فِى [h:14682[ٱ]لْعُقَ[q[د]ِ","ru":"от зла колдуний, поплевывающих на узлы,"},{"n":5,"ar":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","tj":"وَمِ[f:14680[ن ش]َرِّ حَاسِدٍ إِذَا حَسَ[q[د]َ","ru":"от зла завистника, когда он завидует»."}]}