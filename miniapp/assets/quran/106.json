{"n":106,"na":"سُورَةُ قُرَيۡشٍ","ne":"Quraish","nr":"Курайш","nm":"Курайшиты","t":"мекканская","c":4,"bism":true,"a":[{"n":1,"ar":"لِإِيلَـٰفِ قُرَيْشٍ","tj":"لِإِيلَ[n[ـٰ]فِ قُر[p[َي]ْشٍ","ru":"Ради единения курейшитов,"},{"n":2,"ar":"إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ","tj":"إ[n[ِۦ]لَ[n[ـٰ]فِهِمْ رِحْلَةَ [h:14647[ٱ][l[ل]شِّت[o[َا]ٓءِ وَ[h:14648[ٱ][l[ل]صّ[p[َي]ْفِ","ru":"единения их во время зимних и летних поездок."},{"n":3,"ar":"فَلْيَعْبُدُواْ رَبَّ هَـٰذَا ٱلْبَيْتِ","tj":"فَلْيَعْبُدُو[s[اْ] رَبَّ هَ[n[ـٰ]ذَا [h:14649[ٱ]لْب[p[َي]ْتِ","ru":"Пусть же они поклоняются Господу этого Дома (Каабы),"},{"n":4,"ar":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفِۭ","tj":"ٱلَّذ[o[ِىٓ] أَ[q:14650[طْ]عَمَه[w:14651[ُم م]ِّ[f:14454[ن ج]ُو[a:14652[عٍ و]َءَامَنَه[w:14653[ُم م]ِّنْ خ[p[َو]ْفِۭ","ru":"Который накормил их после голода и избавил их от страха."}]}