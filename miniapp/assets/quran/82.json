{"n":82,"na":"سُورَةُ الانفِطَارِ","ne":"Al-Infitaar","nr":"Аль-Инфитар","nm":"Раскалывание","t":"мекканская","c":19,"bism":true,"a":[{"n":1,"ar":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","tj":"إِذَا [h:14351[ٱ][l[ل]سَّم[o[َا]ٓءُ [h:14352[ٱ][f:14353[نف]َطَرَتْ","ru":"Когда небо расколется,"},{"n":2,"ar":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","tj":"وَإِذَا [h:14354[ٱ]لْكَوَاكِبُ [h:14355[ٱ][f:14356[نت]َثَرَتْ","ru":"когда тела небесные осыплются,"},{"n":3,"ar":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","tj":"وَإِذَا [h:14337[ٱ]لْبِحَارُ فُجِّرَتْ","ru":"когда моря перельются и смешаются (или высохнут),"},{"n":4,"ar":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","tj":"وَإِذَا [h:14357[ٱ]لْقُبُورُ بُعْثِرَتْ","ru":"когда могилы перевернутся,"},{"n":5,"ar":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","tj":"عَلِمَتْ نَفْ[a:10644[سٌ م]َّا قَدَّمَتْ وَأَخَّرَتْ","ru":"тогда каждая душа узнает, что она совершила и что оставила после себя."},{"n":6,"ar":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","tj":"يَ[o[ـٰٓ]أَيُّهَا [h:14358[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ مَا غَرَّكَ بِرَبِّكَ [h:14359[ٱ]لْكَر[p[ِي]مِ","ru":"О человек! Что ввело тебя в заблуждение относительно твоего Великодушного Господа,"},{"n":7,"ar":"ٱلَّذِى خَلَقَكَ فَسَوَّٮٰكَ فَعَدَلَكَ","tj":"ٱلَّذِى خَلَقَكَ فَسَوَّ[n[ٮٰ]كَ فَعَدَلَكَ","ru":"Который сотворил тебя и сделал твой облик совершенным и соразмеренным?"},{"n":8,"ar":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ","tj":"ف[o[ِىٓ] أَىِّ صُورَ[a:14360[ةٍ م]َّا ش[o[َا]ٓءَ رَكَّبَكَ","ru":"Он сложил тебя в том облике, в каком пожелал."},{"n":9,"ar":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","tj":"كَلَّا بَلْ تُكَذِّبُونَ بِ[h:14361[ٱ][l[ل]دّ[p[ِي]نِ","ru":"Но нет! Вы же считаете ложью воздаяние."},{"n":10,"ar":"وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ","tj":"وَإِ[g[نّ]َ عَلَيْكُمْ لَحَ[n[ـٰ]فِظ[p[ِي]نَ","ru":"Воистину, над вами есть хранители -"},{"n":11,"ar":"كِرَامًا كَـٰتِبِينَ","tj":"كِرَا[f:14362[مًا ك]َ[n[ـٰ]تِب[p[ِي]نَ","ru":"благородные писцы,"},{"n":12,"ar":"يَعْلَمُونَ مَا تَفْعَلُونَ","tj":"يَعْلَمُونَ مَا تَفْعَل[p[ُو]نَ","ru":"которые знают о том, что вы совершаете."},{"n":13,"ar":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","tj":"إِ[g[نّ]َ [h:14162[ٱ]لْأَ[q:14163[بْ]رَارَ لَفِى نَع[p[ِي]مٍ","ru":"Воистину, благочестивые окажутся в блаженстве."},{"n":14,"ar":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ","tj":"وَإِ[g[نّ]َ [h:14363[ٱ]لْفُجَّارَ لَفِى جَح[p[ِي]مٍ","ru":"Воистину, грешники окажутся в Аду,"},{"n":15,"ar":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","tj":"يَصْلَوْنَهَا يَوْمَ [h:9781[ٱ][l[ل]دّ[p[ِي]نِ","ru":"куда они войдут в День воздаяния."},{"n":16,"ar":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","tj":"وَمَا هُمْ عَنْهَا بِغ[o[َا]ٓئِب[p[ِي]نَ","ru":"Они не смогут избежать этого."},{"n":17,"ar":"وَمَآ أَدْرَٮٰكَ مَا يَوْمُ ٱلدِّينِ","tj":"وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا يَوْمُ [h:11335[ٱ][l[ل]دّ[p[ِي]نِ","ru":"Откуда ты мог знать, что такое День воздаяния?"},{"n":18,"ar":"ثُمَّ مَآ أَدْرَٮٰكَ مَا يَوْمُ ٱلدِّينِ","tj":"ثُ[g[مّ]َ م[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا يَوْمُ [h:11335[ٱ][l[ل]دّ[p[ِي]نِ","ru":"Да, откуда ты мог знать, что такое День воздаяния?"},{"n":19,"ar":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْــًٔا‌ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ","tj":"يَوْمَ لَا تَمْلِكُ نَفْ[u:14364[سٌ ل]ِّنَفْ[f:14365[سٍ ش]َيْـ[a:14366[ـًٔا‌ۖ و]َ[h:4748[ٱ]لْأَمْرُ يَوْمَئِ[u:9076[ذٍ ل]ِّلَّهِ","ru":"В тот день ни одна душа не сможет ничем помочь другой, и власть в тот день будет принадлежать Аллаху."}]}