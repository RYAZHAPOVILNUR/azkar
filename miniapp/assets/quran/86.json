{"n":86,"na":"سُورَةُ الطَّارِقِ","ne":"At-Taariq","nr":"Ат-Тарик","nm":"Ночной путник","t":"мекканская","c":17,"bism":true,"a":[{"n":1,"ar":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","tj":"وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ وَ[h:14418[ٱ][l[ل]طَّارِ[q[ق]ِ","ru":"Клянусь небом и ночным путником!"},{"n":2,"ar":"وَمَآ أَدْرَٮٰكَ مَا ٱلطَّارِقُ","tj":"وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14419[ٱ][l[ل]طَّارِ[q[ق]ُ","ru":"Откуда ты мог знать, что такое ночной путник?"},{"n":3,"ar":"ٱلنَّجْمُ ٱلثَّاقِبُ","tj":"ٱ[l[ل][g[نّ]َ[q:14420[جْ]مُ [h:14421[ٱ][l[ل]ثَّاقِ[q[ب]ُ","ru":"Это - звезда пронизывающая небеса своим светом."},{"n":4,"ar":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","tj":"إِ[f:8426[ن ك]ُلُّ نَفْ[u:14422[سٍ ل]َّ[g[مّ]َا عَلَيْهَا حَافِظٌ","ru":"Нет души, при которой не было бы хранителя."},{"n":5,"ar":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ","tj":"فَلْيَ[f:14313[نظ]ُرِ [h:14314[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ مِ[g[مّ]َ خُلِ[q[ق]َ","ru":"Пусть посмотрит человек, из чего он создан."},{"n":6,"ar":"خُلِقَ مِن مَّآءٍ دَافِقٍ","tj":"خُلِقَ م[a:840[ِن م]ّ[o[َا]ٓ[f:14423[ءٍ د]َافِ[q[ق]ٍ","ru":"Он создан из изливающейся жидкости,"},{"n":7,"ar":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","tj":"يَخْرُجُ م[i:4612[ِنۢ ب]َيْنِ [h:14424[ٱ][l[ل]صُّلْبِ وَ[h:14425[ٱ][l[ل]تَّر[o[َا]ٓئِ[q[ب]ِ","ru":"которая выходит между чреслами и грудными костями."},{"n":8,"ar":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ","tj":"إِ[g[نّ]َهُ[n[ۥ] عَلَىٰ رَ[q:14426[جْ]عِه[n[ِۦ] لَقَادِرٌ","ru":"Воистину, Он способен вернуть его."},{"n":9,"ar":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","tj":"يَوْمَ تُ[q:14427[بْ]لَى [h:14428[ٱ][l[ل]سَّر[o[َا]ٓئِرُ","ru":"В тот день будут испытаны (или раскроются) тайны,"},{"n":10,"ar":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ","tj":"فَمَا لَهُ[n[ۥ] مِ[f:5395[ن ق]ُوَّ[a:14429[ةٍ و]َلَا نَاصِرٍ","ru":"и тогда не будет у него ни силы, ни помощника."},{"n":11,"ar":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","tj":"وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ ذَاتِ [h:14430[ٱ][l[ل]رَّ[q:14431[جْ]عِ","ru":"Клянусь небом возвращающим (возвращающим воду земле или возвращающим небесные тела, которые восходят с одной стороны и заходят в другой)!"},{"n":12,"ar":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","tj":"وَ[h:9999[ٱ]لْأَرْضِ ذَاتِ [h:14432[ٱ][l[ل]صَّ[q:14433[دْ]عِ","ru":"Клянусь землей раскалываемой (при прорастании растений, или при выходе из земли воды, или при воскрешении мертвых)!"},{"n":13,"ar":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ","tj":"إِ[g[نّ]َهُ[n[ۥ] لَقَوْ[f:14434[لٌ ف]َصْلٌ","ru":"Воистину, это - Слово различающее,"},{"n":14,"ar":"وَمَا هُوَ بِٱلْهَزْلِ","tj":"وَمَا هُوَ بِ[h:14435[ٱ]لْهَزْلِ","ru":"а не шутка."},{"n":15,"ar":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","tj":"إِ[g[نّ]َهُمْ يَكِيدُونَ كَيْدًا","ru":"Они замышляют козни,"},{"n":16,"ar":"وَأَكِيدُ كَيْدًا","tj":"وَأَكِيدُ كَيْدًا","ru":"и Я замышляю козни."},{"n":17,"ar":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدَۢا","tj":"فَمَهِّلِ [h:14436[ٱ]لْكَ[n[ـٰ]فِرِينَ أَمْهِلْهُمْ رُوَيْدَۢا","ru":"Предоставь же неверующим отсрочку, помедли с ними недолго!"}]}