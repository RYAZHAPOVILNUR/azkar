{"n":88,"na":"سُورَةُ الغَاشِيَةِ","ne":"Al-Ghaashiya","nr":"Аль-Гашия","nm":"Покрывающее","t":"мекканская","c":26,"bism":true,"a":[{"n":1,"ar":"هَلْ أَتَـٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ","tj":"هَلْ أَتَ[n[ـٰ]كَ حَدِيثُ [h:14451[ٱ]لْغَ[n[ـٰ]شِيَةِ","ru":"Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)?"},{"n":2,"ar":"وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ","tj":"وُجُو[a:14135[هٌ ي]َوْمَئِذٍ خَ[n[ـٰ]شِعَةٌ","ru":"Одни лица в тот день будут унижены,"},{"n":3,"ar":"عَامِلَةٌ نَّاصِبَةٌ","tj":"عَامِلَ[a:14452[ةٌ ن]َّاصِبَةٌ","ru":"изнурены и утомлены."},{"n":4,"ar":"تَصْلَىٰ نَارًا حَامِيَةً","tj":"تَصْلَىٰ نَارًا حَامِيَةً","ru":"Они войдут в Огонь жаркий."},{"n":5,"ar":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ","tj":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ","ru":"Их будут поить из источника кипящего"},{"n":6,"ar":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ","tj":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِ[f:14453[ن ض]َر[p[ِي]عٍ","ru":"и кормить только ядовитыми колючками,"},{"n":7,"ar":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ","tj":"لَّا يُسْمِنُ وَلَا يُغْنِى مِ[f:14454[ن ج][p[ُو]عٍ","ru":"от которых не поправляются и которые не утоляют голода."},{"n":8,"ar":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ","tj":"وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14455[ذٍ ن]َّاعِمَةٌ","ru":"Другие же лица в тот день будут радостны."},{"n":9,"ar":"لِّسَعْيِهَا رَاضِيَةٌ","tj":"لِّسَعْيِهَا رَاضِيَةٌ","ru":"Они будут довольны своими стараниями"},{"n":10,"ar":"فِى جَنَّةٍ عَالِيَةٍ","tj":"فِى جَ[g[نّ]َةٍ عَالِيَةٍ","ru":"в Вышних садах."},{"n":11,"ar":"لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً","tj":"لَّا تَسْمَعُ فِيهَا لَ[n[ـٰ]غِيَةً","ru":"Они не услышат там словоблудия."},{"n":12,"ar":"فِيهَا عَيْنٌ جَارِيَةٌ","tj":"فِيهَا عَيْ[f:14456[نٌ ج]َارِيَةٌ","ru":"Там есть источник текущий."},{"n":13,"ar":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ","tj":"فِيهَا سُرُ[a:14457[رٌ م]َّرْفُوعَةٌ","ru":"Там воздвигнуты ложа,"},{"n":14,"ar":"وَأَكْوَابٌ مَّوْضُوعَةٌ","tj":"وَأَكْوَا[a:14458[بٌ م]َّوْضُوعَةٌ","ru":"расставлены чаши,"},{"n":15,"ar":"وَنَمَارِقُ مَصْفُوفَةٌ","tj":"وَنَمَارِقُ مَصْفُوفَةٌ","ru":"разложены подушки,"},{"n":16,"ar":"وَزَرَابِىُّ مَبْثُوثَةٌ","tj":"وَزَرَابِىُّ مَ[q:14459[بْ]ثُوثَةٌ","ru":"и разостланы ковры."},{"n":17,"ar":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","tj":"أَفَلَا يَ[f:1141[نظ]ُرُونَ إِلَى [h:14460[ٱ]لْإِبِلِ كَيْفَ خُلِقَتْ","ru":"Неужели они не видят, как созданы верблюды,"},{"n":18,"ar":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","tj":"وَإِلَى [h:14461[ٱ][l[ل]سَّم[o[َا]ٓءِ كَيْفَ رُفِعَتْ","ru":"как вознесено небо,"},{"n":19,"ar":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","tj":"وَإِلَى [h:14462[ٱ]لْجِبَالِ كَيْفَ نُصِبَتْ","ru":"как водружены горы,"},{"n":20,"ar":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","tj":"وَإِلَى [h:14463[ٱ]لْأَرْضِ كَيْفَ سُطِحَتْ","ru":"как распростерта земля?"},{"n":21,"ar":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ","tj":"فَذَكِّرْ إِ[g[نّ]َم[o[َآ] أَ[f:169[نت]َ مُذَكِّرٌ","ru":"Наставляй же, ведь ты - наставник,"},{"n":22,"ar":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","tj":"لَّسْتَ عَلَيْه[c:14464[ِم ب]ِمُصَيْطِرٍ","ru":"и ты не властен над ними."},{"n":23,"ar":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","tj":"إِلَّا مَ[f:12995[ن ت]َوَلَّىٰ وَكَفَرَ","ru":"А тех, кто отвернется и не уверует,"},{"n":24,"ar":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","tj":"فَيُعَذِّبُهُ [h:14465[ٱ]للَّهُ [h:14466[ٱ]لْعَذَابَ [h:14467[ٱ]لْأَكْبَرَ","ru":"Аллах подвергнет величайшим мучениям."},{"n":25,"ar":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","tj":"إِ[g[نّ]َ إِلَيْن[o[َآ] إِيَابَهُمْ","ru":"К Нам они вернутся,"},{"n":26,"ar":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","tj":"ثُ[g[مّ]َ إِ[g[نّ]َ عَلَيْنَا حِسَابَهُم","ru":"и затем Мы потребуем у них отчета."}]}