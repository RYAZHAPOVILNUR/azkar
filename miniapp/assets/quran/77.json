{"n":77,"na":"سُورَةُ المُرۡسَلَاتِ","ne":"Al-Mursalaat","nr":"Аль-Мурсалят","nm":"Посылаемые","t":"мекканская","c":50,"bism":true,"a":[{"n":1,"ar":"وَٱلْمُرْسَلَـٰتِ عُرْفًا","tj":"وَ[h:9999[ٱ]لْمُرْسَلَ[n[ـٰ]تِ عُرْفًا","ru":"Клянусь посылаемыми с добром,"},{"n":2,"ar":"فَٱلْعَـٰصِفَـٰتِ عَصْفًا","tj":"فَ[h:9999[ٱ]لْعَ[n[ـٰ]صِفَ[n[ـٰ]تِ عَصْفًا","ru":"несущимися быстро,"},{"n":3,"ar":"وَٱلنَّـٰشِرَٲتِ نَشْرًا","tj":"وَ[h:9999[ٱ][l[ل][g[نّ]َ[n[ـٰ]شِر[n[َٲ]تِ نَشْرًا","ru":"распространяющими бурно,"},{"n":4,"ar":"فَٱلْفَـٰرِقَـٰتِ فَرْقًا","tj":"فَ[h:9999[ٱ]لْفَ[n[ـٰ]رِقَ[n[ـٰ]تِ فَرْقًا","ru":"различающими твердо,"},{"n":5,"ar":"فَٱلْمُلْقِيَـٰتِ ذِكْرًا","tj":"فَ[h:9999[ٱ]لْمُلْقِيَ[n[ـٰ]تِ ذِكْرًا","ru":"и передающими Напоминание"},{"n":6,"ar":"عُذْرًا أَوْ نُذْرًا","tj":"عُذْرًا أَوْ نُذْرًا","ru":"для оправдания или предостережения."},{"n":7,"ar":"إِنَّمَا تُوعَدُونَ لَوَٲقِعٌ","tj":"إِ[g[نّ]َمَا تُوعَدُونَ لَو[n[َٲ]قِعٌ","ru":"Обещанное вам непременно сбудется."},{"n":8,"ar":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","tj":"فَإِذَا [h:14209[ٱ][l[ل][g[نّ]ُجُومُ طُمِسَتْ","ru":"Когда погаснут звезды,"},{"n":9,"ar":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","tj":"وَإِذَا [h:14210[ٱ][l[ل]سَّم[o[َا]ٓءُ فُرِجَتْ","ru":"когда расколется небо,"},{"n":10,"ar":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","tj":"وَإِذَا [h:14211[ٱ]لْجِبَالُ نُسِفَتْ","ru":"когда развеются горы,"},{"n":11,"ar":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","tj":"وَإِذَا [h:14212[ٱ][l[ل]رُّسُلُ أُقِّتَتْ","ru":"когда посланникам будет установлен срок."},{"n":12,"ar":"لِأَىِّ يَوْمٍ أُجِّلَتْ","tj":"لِأَىِّ يَوْمٍ أُجِّلَتْ","ru":"До какого дня отсрочено?"},{"n":13,"ar":"لِيَوْمِ ٱلْفَصْلِ","tj":"لِيَوْمِ [h:14213[ٱ]لْفَصْلِ","ru":"До Дня различения!"},{"n":14,"ar":"وَمَآ أَدْرَٮٰكَ مَا يَوْمُ ٱلْفَصْلِ","tj":"وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا يَوْمُ [h:11336[ٱ]لْفَصْلِ","ru":"Откуда ты мог знать, что такое День различения?"},{"n":15,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ","ru":"Горе в тот день тем, кто считает истину ложью!"},{"n":16,"ar":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","tj":"أَلَمْ نُهْلِكِ [h:14215[ٱ]لْأَوَّل[p[ِي]نَ","ru":"Разве мы не погубили первые поколения?"},{"n":17,"ar":"ثُمَّ نُتْبِعُهُمُ ٱلْأَخِرِينَ","tj":"ثُ[g[مّ]َ نُتْبِعُهُمُ [h:14216[ٱ]لْأَخِر[p[ِي]نَ","ru":"Вслед за ними Мы отправили последующие поколения."},{"n":18,"ar":"كَذَٲلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","tj":"كَذ[n[َٲ]لِكَ نَفْعَلُ بِ[h:11348[ٱ]لْمُ[q:11348[جْ]رِم[p[ِي]نَ","ru":"Так поступаем Мы с грешниками."},{"n":19,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ","ru":"Горе в тот день тем, кто считает истину ложью!"},{"n":20,"ar":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ","tj":"أَلَمْ نَخْلُ[b:14217[ق]كّ[w:14218[ُم م]ّ[a:840[ِن م]ّ[o[َا]ٓ[a:10629[ءٍ م]َّه[p[ِي]نٍ","ru":"Разве Мы не сотворили вас из презренной жидкости"},{"n":21,"ar":"فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ","tj":"فَجَعَلْنَ[n[ـٰ]هُ فِى قَرَا[a:9148[رٍ م]َّك[p[ِي]نٍ","ru":"и не поместили ее в надежном месте"},{"n":22,"ar":"إِلَىٰ قَدَرٍ مَّعْلُومٍ","tj":"إِلَىٰ قَدَ[a:14219[رٍ م]َّعْل[p[ُو]مٍ","ru":"до известного срока?"},{"n":23,"ar":"فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ","tj":"فَقَدَرْنَا فَنِعْمَ [h:14220[ٱ]لْقَ[n[ـٰ]دِر[p[ُو]نَ","ru":"Мы предопределили меру, и как прекрасно Мы предопределяем!"},{"n":24,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ","ru":"Горе в тот день тем, кто считает истину ложью!"},{"n":25,"ar":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","tj":"أَلَمْ نَ[q:14221[جْ]عَلِ [h:14222[ٱ]لْأَرْضَ كِفَاتًا","ru":"Разве Мы не сделали землю вместилищем"},{"n":26,"ar":"أَحْيَآءً وَأَمْوَٲتًا","tj":"أَحْي[o[َا]ٓ[a:14223[ءً و]َأَمْو[n[َٲ]تًا","ru":"для живых и мертвых?"},{"n":27,"ar":"وَجَعَلْنَا فِيهَا رَوَٲسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا","tj":"وَجَعَلْنَا فِيهَا رَو[n[َٲ]سِىَ شَ[n[ـٰ]مِخَ[n[ـٰ][a:14224[تٍ و]َأَسْقَيْنَ[n[ـٰ]ك[w:14225[ُم م]ّ[o[َا]ٓ[f:14226[ءً ف]ُرَاتًا","ru":"Разве Мы не воздвигли на ней незыблемые и высокие горы и не напоили вас пресной водой?"},{"n":28,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ","ru":"Горе в тот день тем, кто считает истину ложью!"},{"n":29,"ar":"ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","tj":"ٱ[f:14227[نط]َلِق[o[ُوٓ][s[اْ] إِلَىٰ مَا كُ[f:100[نت][c:6084[ُم ب]ِه[n[ِۦ] تُكَذِّب[p[ُو]نَ","ru":"Ступайте к тому, что вы считали ложью!"},{"n":30,"ar":"ٱنطَلِقُوٓاْ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ","tj":"ٱ[f:14227[نط]َلِق[o[ُوٓ][s[اْ] إِلَىٰ ظِ[f:14228[لٍّ ذ]ِى ثَلَ[n[ـٰ]ثِ شُعَ[q[ب]ٍ","ru":"Ступайте к тени с тремя разветвлениями."},{"n":31,"ar":"لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","tj":"لَّا ظَلِي[a:14229[لٍ و]َلَا يُغْنِى مِنَ [h:14230[ٱ][l[ل]لَّهَ[q[ب]ِ","ru":"Не прохладна она и от пламени не избавляет,"},{"n":32,"ar":"إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ","tj":"إِ[g[نّ]َهَا تَرْمِى بِشَرَ[f:14231[رٍ ك]َ[h:14232[ٱ]لْقَصْرِ","ru":"а он бросает искры, подобные замку,"},{"n":33,"ar":"كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ","tj":"كَأَ[g[نّ]َهُ[n[ۥ] جِمَ[n[ـٰ]لَ[f:14233[تٌ ص]ُفْرٌ","ru":"который выглядит словно желтые верблюды."},{"n":34,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ","ru":"Горе в тот день тем, кто считает истину ложью!"},{"n":35,"ar":"هَـٰذَا يَوْمُ لَا يَنطِقُونَ","tj":"هَ[n[ـٰ]ذَا يَوْمُ لَا يَ[f:8795[نط]ِق[p[ُو]نَ","ru":"В тот день они будут безмолвствовать,"},{"n":36,"ar":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","tj":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِر[p[ُو]نَ","ru":"и не будет им дозволено оправдываться."},{"n":37,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ","ru":"Горе в тот день тем, кто считает истину ложью!"},{"n":38,"ar":"هَـٰذَا يَوْمُ ٱلْفَصْلِ‌ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ","tj":"هَ[n[ـٰ]ذَا يَوْمُ [h:11336[ٱ]لْفَصْلِ‌ۖ جَمَعْنَ[n[ـٰ]كُمْ وَ[h:14234[ٱ]لْأَوَّل[p[ِي]نَ","ru":"Вот День различения! Мы собрали вас и тех, кто был прежде."},{"n":39,"ar":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ","tj":"فَإِ[f:1670[ن ك]َانَ لَكُمْ كَيْ[f:14235[دٌ ف]َكِيد[p[ُو]نِ","ru":"Если у вас есть какая-нибудь хитрость, то ухитритесь против Меня!"},{"n":40,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ","ru":"Горе в тот день тем, кто считает истину ложью!"},{"n":41,"ar":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ","tj":"إِ[g[نّ]َ [h:7256[ٱ]لْمُتَّقِينَ فِى ظِلَ[n[ـٰ][a:14236[لٍ و]َعُي[p[ُو]نٍ","ru":"А богобоязненные, воистину, пребудут среди сеней и источников"},{"n":42,"ar":"وَفَوَٲكِهَ مِمَّا يَشْتَهُونَ","tj":"وَفَو[n[َٲ]كِهَ مِ[g[مّ]َا يَشْتَه[p[ُو]نَ","ru":"и плодов, каких только пожелают."},{"n":43,"ar":"كُلُواْ وَٱشْرَبُواْ هَنِيٓـــَٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","tj":"كُلُو[s[اْ] وَ[h:300[ٱ]شْرَبُو[s[اْ] هَنِ[o[يٓـ]ـ[i:12907[ـَٔۢا ب]ِمَا كُ[f:100[نت]ُمْ تَعْمَل[p[ُو]نَ","ru":"Ешьте и пейте во здравие за то, что вы совершали!"},{"n":44,"ar":"إِنَّا كَذَٲلِكَ نَجْزِى ٱلْمُحْسِنِينَ","tj":"إِ[g[نّ]َا كَذ[n[َٲ]لِكَ نَ[q:4214[جْ]زِى [h:4215[ٱ]لْمُحْسِن[p[ِي]نَ","ru":"Так Мы вознаграждаем творящих добро."},{"n":45,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ","ru":"Горе в тот день тем, кто считает истину ложью!"},{"n":46,"ar":"كُلُواْ وَتَمَتَّعُواْ قَلِيلاً إِنَّكُم مُّجْرِمُونَ","tj":"كُلُو[s[اْ] وَتَمَتَّعُو[s[اْ] قَلِيلاً إِ[g[نّ]َك[w:14237[ُم م]ُّ[q:12353[جْ]رِم[p[ُو]نَ","ru":"Вкушайте и наслаждайтесь недолго, ведь вы являетесь грешниками."},{"n":47,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ","ru":"Горе в тот день тем, кто считает истину ложью!"},{"n":48,"ar":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُواْ لَا يَرْكَعُونَ","tj":"وَإِذَا قِيلَ لَهُمُ [h:14238[ٱ]رْكَعُو[s[اْ] لَا يَرْكَع[p[ُو]نَ","ru":"Когда им говорят: «Поклонитесь!». - они не кланяются."},{"n":49,"ar":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ","ru":"Горе в тот день тем, кто считает истину ложью!"},{"n":50,"ar":"فَبِأَىِّ حَدِيثِۭ بَعْدَهُۥ يُؤْمِنُونَ","tj":"فَبِأَىِّ حَدِي[i:5170[ثِۭ ب]َعْدَهُ[n[ۥ] يُؤْمِن[p[ُو]نَ","ru":"В какой же рассказ после этого вы уверуете?"}]}